---
import { siteUrl } from '../../utils/url';
import BackLink from '../../components/BackLink.astro';
import Page from '../../layouts/Page.astro';
import ActionButton from '../../components/ActionButton.astro';
import Iconsax from '../../components/Iconsax.astro';
import RectorsDesk from '../../components/RectorsDesk.astro';
import RectorsPhone from '../../components/RectorsPhone.astro';
import { rcImg } from '../../data/rectors';
import '../../styles/school-case.css';
import '../../styles/rectors-case.css';

const img = (n: string) => siteUrl(rcImg(n));
// Пары «было — стало»: скриншоты старого сайта и новые макеты (Figma «Совет ректоров чистовой»)
const hierarchy = [
  { tab: 'Новость', old: 'old-article', now: 'new-article', alt: 'страница новости' },
  { tab: 'Документы', old: 'old-docs', now: 'new-docs', alt: 'страница документов' },
  { tab: 'Обратная связь', old: 'old-hotline', now: 'new-feedback', alt: 'вопросы и ответы' },
];
const visual = [
  { tab: 'Главная', old: 'old-home', now: 'new-home', alt: 'главная страница' },
  { tab: 'Президиум', old: 'old-members', now: 'new-presidium', alt: 'состав Президиума' },
];
const cursor = '<svg viewBox="0 0 24 24" width="30" height="30"><path d="M5 3.2v15.4c0 .5.6.8 1 .4l3.6-3.4 2.4 5.5c.2.4.6.5 1 .4l2-.9c.4-.2.5-.6.4-1l-2.4-5.4 4.9-.3c.5 0 .8-.6.4-1L6 2.8c-.4-.3-1-.1-1 .4Z" fill="#1e1e1e" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg>';
const tokens: [string, string, boolean?][] = [['Акцент', '#0066FF', true], ['Нажатие', '#0038FF', true], ['Заголовки', '#1E1E1E', true], ['Текст', '#404040', true], ['Логотип', '#5A7AAA', true], ['Подписи', '#A8A8A8'], ['Слайдер', '#F0F0F0'], ['Фон', '#FAFAFA']];
---
<Page title="Совет ректоров вузов Москвы: редизайн сайта">
  <article class="sc rc">
    <header class="page-heading sc-cover">
      <BackLink href={siteUrl('/work/')} label="Все работы"/>
      <div class="sc-cover__grid">
        <div class="sc-cover__text">
          <h1>Совет ректоров вузов Москвы: редизайн сайта</h1>
          <p class="sc-cover__lead">Редизайн сайта Совета ректоров вузов Москвы и Московской области: современный облик, понятная навигация и отзывчивая вёрстка для любых устройств.</p>
        </div>
        <div class="rc-hero" data-hero role="img" aria-label="Старая главная страница сайта сменяется новой, курсор листает слайдер и наводит на пункты меню">
          <div class="rc-win" aria-hidden="true">
            <div class="rc-win__bar"><i></i><i></i><i></i><span></span></div>
            <div class="rc-win__view" data-fit="1280">
              <div class="rc-fit">
                <div class="rc-hero__old"><img src={img('old-home.webp')} alt="" width="1107" height="1163"></div>
                <div class="rc-hero__new"><RectorsDesk/></div>
                <span class="rc-hero__line"><b><Iconsax name="arrow-left2-linear" size={14}/><Iconsax name="arrow-right2-linear" size={14}/></b></span>
                <span class="ra-cursor" set:html={cursor}></span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <dl class="sc-meta">
        <div><dt>Роль</dt><dd>UX/UI-дизайнер</dd></div>
        <div><dt>Период</dt><dd>Март — апрель 2022</dd></div>
        <div><dt>Команда</dt><dd>Дизайнер и менеджер проекта, разработчики заказчика</dd></div>
        <div><dt>Аудитория</dt><dd>Вузы Москвы и Московской области, студенты и абитуриенты</dd></div>
      </dl>
    </header>

    <div class="sc-body">
      <section class="sc-sec" aria-labelledby="h-context">
        <div class="sc-head"><h2 id="h-context">Контекст</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Совет ректоров вузов Москвы и Московской области — координирующий орган, который объединяет руководителей вузов столичного региона для решения стратегических задач, развития образования и взаимодействия. На сайте Совет публикует новости, мероприятия, документы и состав, а посетители задают вопросы в обратной связи.</p>
          <div class="rc-old" data-anim role="img" aria-label="Страницы старого сайта: новости, состав Совета и горячая линия">
            <img src={img('old-home.webp')} alt="" width="1107" height="1163" loading="lazy" style="--i:0">
            <img src={img('old-members.webp')} alt="" width="1065" height="860" loading="lazy" style="--i:1">
            <img src={img('old-hotline.webp')} alt="" width="1059" height="833" loading="lazy" style="--i:2">
          </div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-problem">
        <div class="sc-head"><h2 id="h-problem">Задача и проблема</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Старый сайт был рассчитан только на десктоп и плохо читался на телефоне. Страницы выглядели перегруженными и плоскими, разделы были оформлены по‑разному. Нужно было сделать сайт современным и удобным, подготовить его для всех устройств и привести стиль к единому виду.</p>
          <ul class="sc-duties rc-goals" data-anim="once">
            <li style="--i:0"><span class="sc-role__icon"><Iconsax name="brush2-bold" size={28}/></span><h3>Современный и удобный</h3><p>Новый облик и понятная структура разделов.</p></li>
            <li style="--i:1"><span class="sc-role__icon"><Iconsax name="mobile-bold" size={28}/></span><h3>Для всех устройств</h3><p>Сайт одинаково удобен на компьютере, планшете и телефоне.</p></li>
            <li style="--i:2"><span class="sc-role__icon"><Iconsax name="element-4-bold" size={28}/></span><h3>Единый стиль</h3><p>Все разделы собраны из одних и тех же компонентов.</p></li>
          </ul>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-me">
        <div class="sc-head"><h2 id="h-me">Что я делал</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Единственный дизайнер проекта. Работал в паре с проджект‑менеджером, готовые макеты передал разработчикам заказчика.</p>
          <ul class="sc-duties" data-anim="once">
            <li style="--i:0"><span class="sc-role__icon"><Iconsax name="hierarchy-bold" size={28}/></span><h3>Структура и навигация</h3><p>Собрал 13 пунктов бокового меню в четыре раздела в шапке. Структура Совета и документы открываются в подменю.</p></li>
            <li style="--i:1"><span class="sc-role__icon"><Iconsax name="monitor-bold" size={28}/></span><h3>Дизайн страниц</h3><p>Главная, новости, страница новости, Президиум, документы, обратная связь и страница с контентом. Каждая в трёх ширинах: десктоп, планшет и телефон.</p></li>
            <li style="--i:2"><span class="sc-role__icon"><Iconsax name="element-4-bold" size={28}/></span><h3>UI-kit</h3><p>Меню, подменю, кнопки, поиск, карточки новостей и футер со всеми состояниями.</p></li>
            <li style="--i:3"><span class="sc-role__icon"><Iconsax name="code-bold" size={28}/></span><h3>Передача в разработку</h3><p>Подготовил макеты и компоненты для разработчиков заказчика.</p></li>
          </ul>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-nav">
        <div class="sc-head"><h2 id="h-nav">Навигация</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Вместо бокового меню из 13 пунктов — шапка с четырьмя разделами. Структура Совета и документы собраны в подменю, на телефоне оно раскрывается аккордеоном.</p>
          <div class="sc-scale" style="--base:1320px"><div class="rc-nav" data-nav role="img" aria-label="Подменю «Совет ректоров» на десктопе и меню-аккордеон на телефоне">
            <div class="rc-win rc-nav__desk" aria-hidden="true">
              <div class="rc-win__bar"><i></i><i></i><i></i><span></span></div>
              <div class="rc-win__view"><div class="rc-fit"><RectorsDesk sub lazy/><span class="ra-cursor" set:html={cursor}></span></div></div>
            </div>
            <div class="rc-device rc-nav__phone" aria-hidden="true"><div class="rc-device__screen"><RectorsPhone lazy/><span class="ra-tap"></span></div></div>
          </div></div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-hier">
        <div class="sc-head"><h2 id="h-hier">Визуальная иерархия</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Заголовки, подзаголовки, основной текст и второстепенная информация теперь разделены визуально. Старые страницы выглядели перегруженными и плоскими, и было сложно быстро понять, что главное. Новый дизайн направляет взгляд и ускоряет поиск нужной информации.</p>
          <div class="rc-cmp" data-cmp>
            <div class="rc-tabs" role="tablist" aria-label="Страница для сравнения">{hierarchy.map((p, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'}>{p.tab}</button>)}</div>
            <div class="rc-cmp__stage" style="--pos:50%">
              {hierarchy.map((p, i) => <div class:list={['rc-cmp__pair', { 'is-on': i === 0 }]} role="tabpanel" aria-label={p.tab}>
                <img class="rc-cmp__now" src={img(p.now + '.webp')} alt={`Новый сайт: ${p.alt}`} width="1560" height="2900" loading="lazy">
                <div class="rc-cmp__old"><img src={img(p.old + '.webp')} alt={`Старый сайт: ${p.alt}`} width="1080" height="840" loading="lazy"></div>
              </div>)}
              <span class="rc-cmp__tag rc-cmp__tag--old" aria-hidden="true">Было</span><span class="rc-cmp__tag rc-cmp__tag--now" aria-hidden="true">Стало</span>
              <span class="rc-cmp__line" aria-hidden="true"><b><Iconsax name="arrow-left2-linear" size={16}/><Iconsax name="arrow-right2-linear" size={16}/></b></span>
              <input class="rc-cmp__range" type="range" min="0" max="100" value="50" aria-label="Граница между старым и новым сайтом">
            </div>
          </div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-visual">
        <div class="sc-head"><h2 id="h-visual">Визуальная поддержка контента</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Новости, мероприятия и разделы показаны визуальными блоками: карточками, превью и фотографиями. Так сайт выглядит живее и быстрее передаёт содержание страницы. Старый сайт был почти полностью текстовым и выглядел устаревшим.</p>
          <div class="rc-cmp" data-cmp>
            <div class="rc-tabs" role="tablist" aria-label="Страница для сравнения">{visual.map((p, i) => <button type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'}>{p.tab}</button>)}</div>
            <div class="rc-cmp__stage" style="--pos:50%">
              {visual.map((p, i) => <div class:list={['rc-cmp__pair', { 'is-on': i === 0 }]} role="tabpanel" aria-label={p.tab}>
                <img class="rc-cmp__now" src={img(p.now + '.webp')} alt={`Новый сайт: ${p.alt}`} width="1560" height="2900" loading="lazy">
                <div class="rc-cmp__old"><img src={img(p.old + '.webp')} alt={`Старый сайт: ${p.alt}`} width="1080" height="840" loading="lazy"></div>
              </div>)}
              <span class="rc-cmp__tag rc-cmp__tag--old" aria-hidden="true">Было</span><span class="rc-cmp__tag rc-cmp__tag--now" aria-hidden="true">Стало</span>
              <span class="rc-cmp__line" aria-hidden="true"><b><Iconsax name="arrow-left2-linear" size={16}/><Iconsax name="arrow-right2-linear" size={16}/></b></span>
              <input class="rc-cmp__range" type="range" min="0" max="100" value="50" aria-label="Граница между старым и новым сайтом">
            </div>
          </div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-resp">
        <div class="sc-head"><h2 id="h-resp">Отзывчивая вёрстка</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Старый сайт был рассчитан только на десктоп. Новый подстраивается под любую ширину экрана: на телефоне и планшете им так же удобно пользоваться, как на компьютере.</p>
          <div class="sc-scale" style="--base:1320px"><div class="rc-devices" data-anim role="img" aria-label="Главная страница на компьютере, планшете и телефоне">
            <div class="rc-win rc-devices__desk"><div class="rc-win__bar"><i></i><i></i><i></i><span></span></div><div class="rc-win__view"><img class="rc-scroll" src={img('new-home.webp')} alt="" width="1560" height="2849" loading="lazy"></div></div>
            <div class="rc-device rc-devices__tab"><div class="rc-device__screen"><img class="rc-scroll" src={img('new-tablet.webp')} alt="" width="999" height="1560" loading="lazy"></div></div>
            <div class="rc-device rc-devices__phone"><div class="rc-device__screen"><img class="rc-scroll" src={img('new-phone.webp')} alt="" width="416" height="1560" loading="lazy"></div></div>
          </div></div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-ds">
        <div class="sc-head"><h2 id="h-ds">Дизайн-система</h2></div>
        <div class="sc-main">
          <p class="sc-lead">UI-kit построен на шрифте Golos Text и одном акцентном синем. Из одних и тех же компонентов собраны все страницы сайта во всех трёх ширинах.</p>
          <div class="sc-ds">
            <div class="sc-ds__card">
              <h3>Шрифт</h3>
              <p class="sc-font rc-font" aria-hidden="true">Golos Text</p>
              <ul class="sc-weights rc-weights">
                <li style="font-weight:600"><b>600</b>Заголовки страниц и разделов</li>
                <li style="font-weight:500"><b>500</b>Новости, меню и кнопки</li>
                <li style="font-weight:400"><b>400</b>Текст, даты и подписи</li>
              </ul>
            </div>
            <div class="sc-ds__card" data-anim>
              <h3>Цвета</h3>
              <div class="sc-tokens rc-tokens" aria-hidden="true">
                {tokens.map(([n, c, dark], i) => <span class={dark ? 'is-dark' : undefined} style={`--c:${c};--i:${i}`}>{n}<small>{c}</small></span>)}
              </div>
            </div>
            <div class="sc-ds__card rc-kit" data-anim>
              <h3>Компоненты</h3>
              <div class="ra rc-kit__set" aria-hidden="true">
                <span class="rc-kit__btn">Отправить</span>
                <span class="rc-kit__link">Все новости<Iconsax name="arrow-right-linear" size={20}/></span>
                <span class="rc-kit__search"><Iconsax name="search-normal1-linear" size={20}/><span>Введите название новости</span><i></i></span>
                <span class="rc-kit__news">Общее собрание Совета ректоров вузов Москвы и МО</span>
                <span class="rc-kit__pages"><Iconsax name="arrow-left2-linear" size={16}/><b>1</b><span>2</span><span>3</span><span>…</span><span>10</span><Iconsax name="arrow-right2-linear" size={16}/></span>
              </div>
            </div>
          </div>
          <ul class="sc-stats sc-stats--ds">
            <li><strong data-count="7">7</strong><span>типов страниц</span></li>
            <li><strong data-count="3">3</strong><span>ширины: десктоп, планшет и телефон</span></li>
            <li><strong data-count="4">4</strong><span>раздела в меню вместо 13 пунктов</span></li>
          </ul>
        </div>
      </section>
    </div>
  </article>
  <div class="action-row"><ActionButton href={siteUrl('/work/')} label="Посмотреть все работы"/></div>
</Page>
<script>import '../../scripts/rectors-case';</script>
