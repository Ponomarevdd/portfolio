            <div class="sc-ill__palette"><span style="--c:#006EE5"><b>#006EE5</b>Акцент</span><span style="--c:#D1E7FF"><b>#D1E7FF</b>Заливка</span><span style="--c:#1C1C1C"><b>#1C1C1C</b>Контур</span></div>
