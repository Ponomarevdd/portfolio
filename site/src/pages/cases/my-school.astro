---
import { siteUrl } from '../../utils/url';
import BackLink from '../../components/BackLink.astro';
import Page from '../../layouts/Page.astro';
import ActionButton from '../../components/ActionButton.astro';
import Iconsax from '../../components/Iconsax.astro';
import ru from '../../data/russia-dots.json';
import profiles from '../../data/school-profiles.json';
import '@fontsource/geologica/latin-300.css';
import '@fontsource/geologica/cyrillic-300.css';
import '@fontsource/geologica/latin-500.css';
import '@fontsource/geologica/cyrillic-500.css';
import '@fontsource/geologica/latin-600.css';
import '@fontsource/geologica/cyrillic-600.css';
import '../../styles/school-case.css';

const img = (name: string) => siteUrl(`/images/school-platform/${name}`);

// Точечная карта России для блока «Контекст»: точки сетки внутри границы, одним path.
const r = ru.step * .32;
const dotPath = ru.pts.map(([x, y]) => `M${x - r} ${y}a${r} ${r} 0 1 0 ${r * 2} 0a${r} ${r} 0 1 0 ${-r * 2} 0`).join('');
const cities = Object.values(ru.cities) as [number, number][];

// Боли из интервью и то, чем мы на них ответили.
const pains = [
  { quote: 'Открыла, а там двадцать разделов. Куда нажимать?', who: 'Учитель начальных классов', idea: 'Курс «С чего начать»', note: 'Первые шаги в платформе за 10 минут' },
  { quote: 'Нужное нашла только на тридцатой странице', who: 'Учитель математики', idea: 'Короткие уроки', note: 'Содержание и вкладки вместо одной длинной инструкции' },
  { quote: 'Боюсь ошибиться прямо при классе', who: 'Учитель истории', idea: 'Тренажёр', note: 'Сценарий отрабатывается без риска для реального класса' },
  { quote: 'Не уверена, что ученики увидели задание', who: 'Учитель биологии', idea: 'Статусы задания', note: 'Видно, кто открыл и кто выполнил' },
];
const queue = [
  { text: 'Где создать шаблон задания?', from: 'Школа № 12 · 08:14', same: true },
  { text: 'Как назначить тест классу?', from: 'Лицей № 3 · 08:16' },
  { text: 'Где создать шаблон задания?', from: 'Школа № 41 · 08:19', same: true },
  { text: 'Не вижу раздел «Тесты»', from: 'Гимназия № 7 · 08:21' },
  { text: 'Где создать шаблон задания?', from: 'Школа № 105 · 08:22', same: true },
];
const lessons = [
  { title: 'С чего начать работу в Цифровой платформе', course: 'Модуль 1 · Знакомство с системой', format: 'Лонгрид', icon: 'document-text-bold', time: '10 мин' },
  { title: 'Роль педагогического работника в Цифровой платформе', course: 'Модуль 1 · Знакомство с системой', format: 'Лонгрид', icon: 'document-text-bold', time: '10 мин' },
  { title: 'Самопроверка', course: 'Модуль 1 · Знакомство с системой', format: 'Тест', icon: 'tick-square-bold', time: '5 мин' },
  { title: 'Знакомство с подсистемами', course: 'Модуль 2 · Подсистемы', format: 'Лонгрид', icon: 'document-text-bold', time: '12 мин' },
];
---
<Page title="Цифровая платформа для школ">
  <article class="sc">
    <header class="page-heading sc-cover">
      <BackLink href={siteUrl('/work/')} label="Все работы"/>
      <div class="sc-cover__grid">
        <div class="sc-cover__text">
          <p class="sc-eyebrow">Цифровая платформа для школ</p>
          <h1>Как научить педагогов всей страны работать в новой платформе</h1>
          <p class="sc-cover__lead">45 лонгридов, LMS и дизайн-система для педагогов и администраторов школ.</p>
        </div>
        <div class="sc-collage" data-anim aria-label="Фрагменты интерфейса: шапка урока, карточка курса, вопрос самопроверки и иллюстрация" role="img">
          <div class="ui sc-frag sc-frag--header">
            <span class="ui-badge">Модуль 1 · Урок 1</span>
            <p class="ui-h">С чего начать работу в Цифровой платформе</p>
            <div class="ui-tags"><span><Iconsax name="document-text-bold" size={14}/>Лонгрид</span><span><Iconsax name="clock-bold" size={14}/>10 мин</span></div>
          </div>
          <div class="ui sc-frag sc-frag--course">
            <span class="ui-badge">Обязательный</span>
            <p class="ui-h ui-h--s">Курс для педагогов</p>
            <p class="ui-cap">18 уроков · 4 модуля</p>
            <div class="ui-bar"><span class="ui-bar__fill sc-fill"></span></div>
          </div>
          <div class="ui sc-frag sc-frag--quiz">
            <p class="ui-h ui-h--xs">Какой тип заданий проверяет эксперт?</p>
            <span class="ui-opt">Выбрать ответ</span>
            <span class="ui-opt ui-opt--right">Диктант<Iconsax name="tick-circle-bold" size={16}/></span>
          </div>
          <div class="sc-frag sc-frag--ill"><img src={img('lesson-hero.png')} alt="" width="1466" height="1308"/></div>
        </div>
      </div>
      <dl class="sc-meta">
        <div><dt>Роль</dt><dd>Ведущий дизайнер</dd></div>
        <div><dt>Период</dt><dd>Август — октябрь 2023</dd></div>
        <div><dt>Команда</dt><dd>3 дизайнера, методист, редактор</dd></div>
        <div><dt>Аудитория</dt><dd>Педагоги и администраторы школ</dd></div>
      </dl>
      <p class="sc-nda"><Iconsax name="lock-bold" size={16}/>Проект выполнен под NDA. Название системы, данные и часть интерфейса изменены.</p>
    </header>

    <div class="sc-body">
      <section class="sc-sec" aria-labelledby="h-context">
        <div class="sc-head"><h2 id="h-context">Контекст</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Цифровая платформа для школ объединяет журнал, библиотеку контента, тесты и файлы. Её нужно было запустить сразу по всей России, и каждый педагог должен был перейти на неё за один учебный год.</p>
          <div class="sc-context" data-anim>
            <div class="sc-map" aria-hidden="true">
              <svg viewBox={`0 0 ${ru.w} ${ru.h}`}><path class="sc-map__base" d={dotPath}/></svg>
              <div class="sc-map__reveal"><div><svg viewBox={`0 0 ${ru.w} ${ru.h}`}><path class="sc-map__lit" d={dotPath}/></svg></div></div>
              {cities.map(([x, y]) => <span class="sc-map__city" style={`left:${x / ru.w * 100}%;top:${y / ru.h * 100}%;--x:${(x / ru.w).toFixed(2)}`}></span>)}
            </div>
          </div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-problem">
        <div class="sc-head"><h2 id="h-problem">Задача и проблема</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Платформу внедряли быстрее, чем люди успевали её освоить. Обучающих материалов для педагогов не было, и поддержка тонула в одинаковых вопросах из разных регионов.</p>
          <figure class="sc-queue" data-anim>
            <ul class="ui" aria-hidden="true">
              {queue.map((q, i) => <li class={`ui-ticket a-ticket${q.same ? ' ui-ticket--same' : ''}`} style={`--i:${i}`}><Iconsax name="message-bold" size={18}/><span>{q.text}<small>{q.from}</small></span>{q.same && <em>повтор</em>}</li>)}
            </ul>
          </figure>
          <p>Задача: сделать обучение, после которого педагог сам проходит ключевые сценарии в платформе, а поддержка перестаёт отвечать на одни и те же вопросы.</p>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-roles">
        <div class="sc-head"><h2 id="h-roles">Для кого: две роли</h2></div>
        <div class="sc-main">
          <div class="sc-roles">
            <div class="sc-role">
              <span class="sc-role__icon"><Iconsax name="teacher-bold" size={28}/></span>
              <h3>Педагог</h3>
              <p class="sc-role__goal">Вести журнал, создавать задания и тесты, назначать материалы из библиотеки.</p>
              <ul><li>Мало времени между уроками</li><li>Разный уровень цифровых навыков</li><li>Страх ошибиться на глазах у класса</li></ul>
            </div>
            <div class="sc-role">
              <span class="sc-role__icon"><Iconsax name="building-bold" size={28}/></span>
              <h3>Администратор школы</h3>
              <p class="sc-role__goal">Настроить школу в платформе, завести педагогов и классы, следить за внедрением.</p>
              <ul><li>Отвечает за всю школу сразу</li><li>Редкие, но сложные сценарии</li><li>Вопросы коллег идут к нему</li></ul>
            </div>
          </div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-research">
        <div class="sc-head"><h2 id="h-research">Исследование</h2></div>
        <div class="sc-main">
          <p class="sc-lead">12 интервью с педагогами и администраторами из пяти регионов. Вот что мешало им начать работать.</p>
          <figure class="sc-pains" data-anim="once">
            <div class="sc-pains__head" aria-hidden="true"><span>Боль</span><span></span><span>Решение</span></div>
            <ul>
              {pains.map((p, i) => <li style={`--i:${i}`}>
                <blockquote class="sc-pain"><Iconsax name="quote-up-bold" size={20}/><p>{p.quote}</p><cite>{p.who}</cite></blockquote>
                <span class="sc-pains__arrow" aria-hidden="true"><Iconsax name="arrow-right-linear" size={24}/></span>
                <div class="sc-fix"><Iconsax name="lamp-on-bold" size={20}/><strong>{p.idea}</strong><small>{p.note}</small></div>
              </li>)}
            </ul>
          </figure>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-principles">
        <div class="sc-head"><h2 id="h-principles">Принципы</h2></div>
        <div class="sc-main">
          <ol class="sc-principles">
            <li class="sc-pr" data-anim>
              <div class="sc-pr__text"><h3>Одна мысль на экран</h3><p>Карточка отвечает на один вопрос. Длинные перечни уходят во вкладки.</p></div>
              <div class="sc-pr__stage ui" aria-hidden="true">
                <p class="ui-h ui-h--xs">Подсистемы платформы</p>
                <div class="pr-sys">
                  <span class="pr-sys__main"><span class="ui-badge">В этом уроке</span><b>Тесты</b><small>Оценка знаний</small></span>
                  {[['Базовая платформа', 'Обозреватель'], ['Библиотека', 'Проверенный контент'], ['Файлы', 'Онлайн-офис'], ['Аналитика', 'Сбор показателей']].map(([t, c], i) => <span class="pr-sys__item" style={`--i:${i}`}><b>{t}</b><small>{c}</small></span>)}
                </div>
              </div>
            </li>
            <li class="sc-pr" data-anim>
              <div class="sc-pr__text"><h3>Прогресс всегда виден</h3><p>Человек знает, где он, сколько прошёл и сколько осталось.</p></div>
              <div class="sc-pr__stage ui" aria-hidden="true">
                <p class="ui-h ui-h--xs">Создание шаблона</p>
                <ol class="pr-steps">
                  {[['Нажмите «+ Новый шаблон»', 'Кнопка справа вверху, над списком шаблонов'], ['Выберите тип и напишите вопрос', 'К вопросу можно добавить картинку или файл'], ['Настройте ответы', 'Отметьте, какой вариант верный']].map(([t, c], i) => <li style={`--i:${i}`}><i>{i + 1}</i><span><b>{t}</b><small>{c}</small></span></li>)}
                </ol>
              </div>
            </li>
            <li class="sc-pr" data-anim>
              <div class="sc-pr__text"><h3>Проверь себя, прежде чем идти в систему</h3><p>Самопроверка и тренажёр до работы с настоящим классом.</p></div>
              <div class="sc-pr__stage ui" aria-hidden="true">
                <div class="pr-tpl__top"><p class="ui-h ui-h--xs">Шаблон 1</p><span class="ui-badge">Выбрать ответ</span></div>
                <p class="ui-cap">Название шаблона</p><p class="pr-tpl__name">Биология 1</p>
                <p class="ui-cap">Ответы</p>
                <div class="pr-tpl__opts">
                  {['Ракообразные', 'Кораллы', 'Морские звёзды', 'Кальмары'].map((o, i) => <span class={`pr-tpl__opt${i === 1 ? ' pr-tpl__opt--ok' : ''}`}>{o}{i === 1 && <em>верный</em>}</span>)}
                </div>
              </div>
            </li>
          </ol>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-arch">
        <div class="sc-head"><h2 id="h-arch">Архитектура и user flow</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Курс педагога: 18 уроков в 4 модулях. Каждый урок собран из форматов, и человек выбирает тот, что удобнее прямо сейчас.</p>
          <div class="sc-tree" aria-label="Структура курса">
            <div class="sc-tree__node sc-tree__node--root">Курс</div>
            <div class="sc-tree__node">4 модуля</div>
            <div class="sc-tree__node">18 уроков</div>
            <ul class="sc-tree__formats">
              <li><Iconsax name="document-text-bold" size={18}/>Лонгрид</li>
              <li><Iconsax name="play-circle-bold" size={18}/>Видео</li>
              <li><Iconsax name="document-download-bold" size={18}/>Конспект</li>
              <li><Iconsax name="tick-square-bold" size={18}/>Тест</li>
            </ul>
          </div>
          <div class="sc-flow" data-anim>
            <h3>Путь в LMS</h3>
            <ol>
              <li style="--i:0">«Моё обучение»</li>
              <li style="--i:1">Курс</li>
              <li style="--i:2">Урок</li>
              <li style="--i:3">Самопроверка</li>
              <li style="--i:4"><Iconsax name="award-bold" size={18}/>Сертификат</li>
            </ol>
            <span class="sc-flow__dot" aria-hidden="true"></span>
          </div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-wire">
        <div class="sc-head"><h2 id="h-wire">От вайрфрейма к интерфейсу</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Шапка урока прошла три состояния: структура, серый макет и готовый блок на токенах дизайн-системы.</p>
          <div class="sc-states" data-anim aria-label="Шапка урока в трёх состояниях" role="img">
            <div class="sc-state sc-state--wire">
              <span class="w w--badge"></span><span class="w w--h"></span><span class="w w--h w--short"></span><span class="w w--tags"></span><span class="w w--img"></span>
            </div>
            <div class="sc-state sc-state--grey ui">
              <span class="g-badge">Модуль 1</span><p class="ui-h">С чего начать работу</p><div class="g-tags"><span>Лонгрид</span><span>10 мин</span></div><span class="g-img"></span>
            </div>
            <div class="sc-state sc-state--ui ui">
              <span class="ui-badge">Модуль 1 · Урок 1</span><p class="ui-h">С чего начать работу в Цифровой платформе</p><div class="ui-tags"><span><Iconsax name="document-text-bold" size={14}/>Лонгрид</span><span><Iconsax name="clock-bold" size={14}/>10 мин</span></div><img src={img('lesson-hero.png')} alt="" width="1466" height="1308"/>
            </div>
            <ol class="sc-states__legend"><li>Структура</li><li>Серый макет</li><li>Интерфейс</li></ol>
          </div>
          <h3 class="sc-sub">Что пробовали и почему отказались</h3>
          <div class="sc-variants">
            <div class="sc-variant">
              <p class="sc-variant__topic">Задачи платформы</p>
              <div class="sc-variant__pair">
                <div class="sc-mini sc-mini--no"><span class="sc-mini__tag">Схема с центром</span><div class="mini-scheme"><i></i><i></i><i></i><i class="c"></i><i></i><i></i></div></div>
                <div class="sc-mini sc-mini--yes"><span class="sc-mini__tag">Аккордеон</span><div class="mini-acc"><i class="o"></i><i></i><i></i></div></div>
              </div>
              <p>Схема красиво смотрелась, но три направления по четыре длинных пункта превращали её в мелкий текст в рамках. Аккордеон держит одну мысль открытой.</p>
            </div>
            <div class="sc-variant">
              <p class="sc-variant__topic">Разделы платформы</p>
              <div class="sc-variant__pair">
                <div class="sc-mini sc-mini--no"><span class="sc-mini__tag">Вкладки</span><div class="mini-tabs"><i class="o"></i><i></i><i></i></div></div>
                <div class="sc-mini sc-mini--yes"><span class="sc-mini__tag">«Тесты» крупно</span><div class="mini-big"><i class="b"></i><i></i><i></i><i></i><i></i></div></div>
              </div>
              <p>Во вкладках все разделы выглядели равными. Урок про тесты, поэтому этот раздел стал крупной карточкой, а остальные остались рядом для контекста.</p>
            </div>
            <div class="sc-variant">
              <p class="sc-variant__topic">Типы заданий</p>
              <div class="sc-variant__pair">
                <div class="sc-mini sc-mini--no"><span class="sc-mini__tag">Список карточек</span><div class="mini-list"><i></i><i></i><i></i><i></i></div></div>
                <div class="sc-mini sc-mini--yes"><span class="sc-mini__tag">Таблица</span><div class="mini-table"><i></i><i></i><i></i><i></i><i></i><i></i></div></div>
              </div>
              <p>Главный вопрос педагога «кто проверит ответ». Таблица из двух колонок отвечает на него сразу, без чтения десяти карточек.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-anatomy">
        <div class="sc-head"><h2 id="h-anatomy">Анатомия урока</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Каждый блок урока закрывает конкретную боль из исследования.</p>
          <div class="sc-anatomy">
            <div class="sc-part" data-anim>
              <div class="sc-part__stage sc-part__stage--head ui">
                <span class="ui-badge">Модуль 1 · Урок 1</span><p class="ui-h ui-h--s">С чего начать работу в Цифровой платформе</p><div class="ui-tags"><span><Iconsax name="document-text-bold" size={14}/>Лонгрид</span><span><Iconsax name="clock-bold" size={14}/>10 мин</span></div><img class="a-float" src={img('lesson-hero.png')} alt="" width="1466" height="1308" loading="lazy" decoding="async"/>
              </div>
              <h3>Шапка урока</h3><p class="sc-pain"><span>Закрывает боль</span>«Непонятно, с чего начать и сколько это займёт»</p>
            </div>
            <div class="sc-part" data-anim>
              <div class="sc-part__stage ui">
                <p class="ui-h ui-h--xs">Содержание</p><p class="ui-cap">Изучено 3 из 5 разделов</p>
                <div class="ui-toc__list"><span class="ui-toc__rail"><span class="a-rail"></span></span>
                  {['О платформе', 'Задачи', 'Разделы', 'Создание шаблона', 'Самопроверка'].map((t, i) => <span class="ui-toc__item"><i class="a-dot" style={`animation-delay:${i * .9}s`}></i>{t}</span>)}
                </div>
              </div>
              <h3>Содержание с прогрессом</h3><p class="sc-pain"><span>Закрывает боль</span>«Слишком много текста, не найти нужное»</p>
            </div>
            <div class="sc-part" data-anim>
              <div class="sc-part__stage ui">
                <div class="ui-tabs__bar"><span class="ui-tabs__thumb a-tab"></span><span>Журнал</span><span>Тесты</span><span>Файлы</span></div>
                <div class="ui-tabs__body"><span class="ui-line"></span><span class="ui-line ui-line--m"></span><span class="ui-line ui-line--s"></span></div>
              </div>
              <h3>Вкладки</h3><p class="sc-pain"><span>Закрывает боль</span>«Бросаю длинный материал на середине»</p>
            </div>
            <div class="sc-part" data-anim>
              <div class="sc-part__stage ui">
                <div class="ui-video"><Iconsax name="play-circle-bold" size={44}/><span class="ui-video__bar"><span class="a-play"></span></span></div>
                <div class="ui-video__meta"><span class="ui-badge">Видео</span><span class="ui-cap">Раздел «Шаблоны» · 6 мин</span></div>
              </div>
              <h3>Видео</h3><p class="sc-pain"><span>Закрывает боль</span>«Проще один раз увидеть, чем читать»</p>
