---
import { siteUrl } from '../../utils/url';
import BackLink from '../../components/BackLink.astro';
import Page from '../../layouts/Page.astro';
import ActionButton from '../../components/ActionButton.astro';
import Iconsax from '../../components/Iconsax.astro';
import LongreadMini from '../../components/LongreadMini.astro';
import ru from '../../data/russia-dots.json';
import profiles from '../../data/school-profiles.json';
import '../../styles/school-case.css';

const img = (name: string) => siteUrl(`/images/school-platform/${name}`);

// Точечная карта России для блока «Контекст»: точки сетки внутри границы, одним path.
const r = ru.step * .32;
const dotPath = ru.pts.map(([x, y]) => `M${x - r} ${y}a${r} ${r} 0 1 0 ${r * 2} 0a${r} ${r} 0 1 0 ${-r * 2} 0`).join('');
const cities = Object.values(ru.cities) as [number, number][];

// Боли из интервью и то, чем мы на них ответили.
const subsystems = [
  ['Базовая платформа', 'Обозреватель'],
  ['Библиотека', 'Верифицированный контент'],
  ['Файлы', 'Расширенный онлайн-офис'],
  ['ЕТД', 'Администрирование системы'],
  ['Аналитика', 'Сбор информации по показателям ФП «Цифровая образовательная среда»'],
  ['Помощник ученика', 'Подготовка к ГИА и ВПР'],
  ['Смарт ТВ', 'Вывод контента на экран'],
];
const tasks = [
  ['Выбрать ответ', 'Классический тест: ученик выбирает один или несколько вариантов ответа.'],
  ['Выбрать из списка', 'Ученик выбирает вариант из выпадающего списка прямо в тексте задания.'],
  ['Ввести ответ', 'Ученик вводит ответ с клавиатуры, система сверяет его с эталоном.'],
];
const personas = [
  {
    ava: 'persona-olga.webp', name: 'Ольга Викторовна', meta: '54 года · учитель начальных классов · стаж 30 лет',
    quote: 'Мне бы понять, куда нажать, а дальше я сама.',
    want: ['Вести журнал и давать задания без помощи коллег', 'Не тратить перемену на поиск нужной кнопки'],
    block: ['Привыкла к бумажному журналу', 'Длинные инструкции не дочитывает', 'Боится ошибиться при классе'],
    skill: 2, where: ['Компьютер в кабинете', 'Телефон по вечерам'],
  },
  {
    ava: 'persona-sergey.webp', name: 'Сергей Николаевич', meta: '49 лет · заместитель директора · отвечает за внедрение',
    quote: 'Все вопросы идут ко мне, а ответы я ищу сам.',
    want: ['Завести педагогов и классы за один раз', 'Видеть, кто уже начал работать'],
    block: ['Сложные сценарии бывают раз в полгода', 'Нет времени разбираться в деталях', 'Коллеги ждут ответа сразу'],
    skill: 3, where: ['Компьютер в кабинете', 'Совещания и планёрки'],
  },
];
const pains = [
  { quote: 'Открыла, а там двадцать разделов. Куда нажимать?', who: 'Учитель начальных классов', idea: 'Курс «С чего начать»', note: 'Первые шаги в платформе за 10 минут' },
  { quote: 'Нужное нашла только на тридцатой странице', who: 'Учитель математики', idea: 'Короткие уроки', note: 'Содержание и вкладки вместо одной длинной инструкции' },
  { quote: 'Боюсь ошибиться прямо при классе', who: 'Учитель истории', idea: 'Тренажёр', note: 'Сценарий отрабатывается без риска для реального класса' },
  { quote: 'Не уверена, что ученики увидели задание', who: 'Учитель биологии', idea: 'Статусы задания', note: 'Видно, кто открыл и кто выполнил' },
];
const queue = [
  { text: 'Где создать шаблон задания?', from: 'Школа № 12 · 08:14', same: true },
  { text: 'Как назначить тест классу?', from: 'Лицей № 3 · 08:16' },
  { text: 'Где создать шаблон задания?', from: 'Школа № 41 · 08:19', same: true },
  { text: 'Не вижу раздел «Тесты»', from: 'Гимназия № 7 · 08:21' },
  { text: 'Где создать шаблон задания?', from: 'Школа № 105 · 08:22', same: true },
];
const lessons = [
  { title: 'С чего начать работу в Цифровой платформе', course: 'Модуль 1 · Знакомство с системой', format: 'Лонгрид', icon: 'document-text-bold', time: '10 мин' },
  { title: 'Роль педагогического работника в Цифровой платформе', course: 'Модуль 1 · Знакомство с системой', format: 'Лонгрид', icon: 'document-text-bold', time: '10 мин' },
  { title: 'Самопроверка', course: 'Модуль 1 · Знакомство с системой', format: 'Тест', icon: 'tick-square-bold', time: '5 мин' },
  { title: 'Знакомство с подсистемами', course: 'Модуль 2 · Подсистемы', format: 'Лонгрид', icon: 'document-text-bold', time: '12 мин' },
];
---
<Page title="Курс «Цифровая платформа для школ»">
  <article class="sc">
    <header class="page-heading sc-cover">
      <BackLink href={siteUrl('/work/')} label="Все работы"/>
      <div class="sc-cover__grid">
        <div class="sc-cover__text">
          <h1>Курс «Цифровая платформа для школ»</h1>
          <p class="sc-cover__lead">Обучающий курс для новой школьной платформы, которую запускали по всей стране. Педагоги и администраторы шаг за шагом учатся вести журнал, создавать тесты и работать с контентом.</p>
        </div>
        <div class="ui sc-hl" data-anim aria-label="Урок собирается из блоков: шапка, содержание, заметка, самопроверка и «Урок пройден»" role="img">
          <div class="sc-hl__bar"><i></i><i></i><i></i><span></span></div>
          <div class="sc-hl__track">
            <div class="sc-hl__b sc-hl__head">
              <span class="ui-badge">Модуль 1 · Урок 1</span>
              <p class="ui-h">С чего начать работу в Цифровой платформе</p>
              <div class="ui-tags"><span><Iconsax name="document-text-bold" size={14}/>Лонгрид</span><span><Iconsax name="clock-bold" size={14}/>10 мин</span></div>
              <img src={img('lesson-hero.png')} alt="" width="1466" height="1308"/>
            </div>
            <div class="sc-hl__b sc-hl__toc">
              <p class="ui-h ui-h--xs">Содержание</p>
              <ul>{['О платформе', 'Задачи', 'Разделы', 'Самопроверка'].map((t, i) => <li style={`--i:${i}`}><i></i>{t}</li>)}</ul>
            </div>
            <div class="sc-hl__b sc-hl__note">
              <span class="sc-hl__note-h"><Iconsax name="info-circle-bold" size={20}/>Обратите внимание</span>
              <i></i><i></i><i></i>
            </div>
            <div class="sc-hl__b sc-hl__quiz">
              <p class="ui-h ui-h--xs">Какой тип заданий проверяет эксперт?</p>
              <span class="ui-opt">Выбрать ответ</span>
              <span class="ui-opt sc-hl__opt">Диктант<Iconsax name="tick-circle-linear" size={18}/>
                <span class="sc-hl__cur"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M5 3.2v15.4c0 .5.6.8 1 .4l3.6-3.4 2.4 5.5c.2.4.6.5 1 .4l2-.9c.4-.2.5-.6.4-1l-2.4-5.4 4.9-.3c.5 0 .8-.6.4-1L6 2.8c-.4-.3-1-.1-1 .4Z" fill="#1c1c1c" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg></span>
              </span>
              <span class="sc-hl__fb">Верно: диктант проверяет эксперт</span>
            </div>
            <div class="sc-hl__b sc-hl__done">
              <span class="sc-hl__cup"><Iconsax name="cup-bold" size={28}/></span>
              <span><b>Урок пройден</b><small>Следующий: Роль педагога в платформе</small></span>
            </div>
          </div>
        </div>
      </div>
      <dl class="sc-meta">
        <div><dt>Роль</dt><dd>Лид-дизайнер</dd></div>
        <div><dt>Период</dt><dd>Август — октябрь 2023</dd></div>
        <div><dt>Команда</dt><dd>3&nbsp;дизайнера под моим руководством, 3&nbsp;методиста, редактор, проджект‑менеджер</dd></div>
        <div><dt>Аудитория</dt><dd>Педагоги и администраторы школ</dd></div>
      </dl>
      <p class="sc-nda"><Iconsax name="lock-bold" size={16}/>Проект выполнен под NDA. Название системы, данные и часть интерфейса изменены.</p>
    </header>

    <div class="sc-body">
      <section class="sc-sec" aria-labelledby="h-context">
        <div class="sc-head"><h2 id="h-context">Контекст</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Цифровую платформу для школ запускали по всей стране. В ней есть журнал, библиотека контента, тесты, файлы и курсы для педагогов. Мы делали один из этих курсов: 45 лонгридов о том, как работать в самой платформе.</p>
          <div class="sc-context" data-anim>
            <div class="sc-map" aria-hidden="true">
              <svg viewBox={`0 0 ${ru.w} ${ru.h}`}><path class="sc-map__base" d={dotPath}/></svg>
              <div class="sc-map__reveal"><div><svg viewBox={`0 0 ${ru.w} ${ru.h}`}><path class="sc-map__lit" d={dotPath}/></svg></div></div>
              {cities.map(([x, y]) => <span class="sc-map__city" style={`left:${x / ru.w * 100}%;top:${y / ru.h * 100}%;--x:${(x / ru.w).toFixed(2)}`}></span>)}
            </div>
          </div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-problem">
        <div class="sc-head"><h2 id="h-problem">Задача и проблема</h2></div>
        <div class="sc-main">
          <div class="sc-problem">
            <div class="sc-problem__text">
              <p class="sc-lead">Платформу внедряли быстрее, чем люди успевали её освоить. Обучающих материалов для педагогов не было, и поддержка тонула в одинаковых вопросах из разных регионов.</p>
              <p>Задача: сделать обучение, после которого педагог сам проходит ключевые сценарии в платформе, а поддержка перестаёт отвечать на одни и те же вопросы.</p>
            </div>
            <figure class="sc-queue" data-anim>
            <ul class="ui" aria-hidden="true">
              {queue.map((q, i) => <li class={`ui-ticket a-ticket${q.same ? ' ui-ticket--same' : ''}`} style={`--i:${i}`}><Iconsax name="message-bold" size={18}/><span>{q.text}<small>{q.from}</small></span>{q.same && <em>повтор</em>}</li>)}
            </ul>
          </figure>
          </div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-me">
        <div class="sc-head"><h2 id="h-me">Что я делал</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Задал визуальный язык и UI-kit проекта, руководил командой из трёх дизайнеров и отвечал за качество всех 45 лонгридов.</p>
          <ul class="sc-duties" data-anim="once">
            <li style="--i:0"><span class="sc-role__icon"><Iconsax name="brush2-bold" size={28}/></span><h3>Визуальное направление</h3><p>Определил стиль лонгридов: цвета, типографику, иллюстрации, ритм и иерархию урока.</p></li>
            <li style="--i:1"><span class="sc-role__icon"><Iconsax name="element-4-bold" size={28}/></span><h3>UI-kit</h3><p>Собрал UI-kit на 60+ компонентов: блоки урока с состояниями и ховерами, графика, сетка отступов, скругления и т. д. Все 45 лонгридов собраны на нём.</p></li>
            <li style="--i:2"><span class="sc-role__icon"><Iconsax name="hierarchy-bold" size={28}/></span><h3>Структура урока</h3><p>Спроектировал, как устроен лонгрид и как в него встроены видео, PDF-конспект и самопроверка.</p></li>
            <li style="--i:3"><span class="sc-role__icon"><Iconsax name="document-text-bold" size={28}/></span><h3>Первые уроки</h3><p>Сам собрал первые лонгриды и на них отладил систему, прежде чем передать её команде.</p></li>
            <li style="--i:4"><span class="sc-role__icon"><Iconsax name="people-bold" size={28}/></span><h3>Команда</h3><p>Руководил тремя дизайнерами: распределял уроки, вводил в проект и UI-kit, давал свободу предлагать новое в рамках стиля, проводил дизайн-ревью каждого урока.</p></li>
            <li style="--i:5"><span class="sc-role__icon"><Iconsax name="message-bold" size={28}/></span><h3>Заказчик и руководство</h3><p>Презентовал решения, собирал обратную связь и переводил её в задачи для команды.</p></li>
            <li style="--i:6"><span class="sc-role__icon"><Iconsax name="clipboard-text-bold" size={28}/></span><h3>Работа со смежниками</h3><p>Вместе с методистами и редактором выстраивал подачу материала, с проджект-менеджером планировал сроки выпуска.</p></li>
            <li style="--i:7"><span class="sc-role__icon"><Iconsax name="global-bold" size={28}/></span><h3>Техническая часть</h3><p>Продумал доставку контента: видео и конспекты через CDN для быстрой загрузки. Вместе с коллегами готовил офлайн-версию на внешних носителях для районов без стабильного интернета.</p></li>
          </ul>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-roles">
        <div class="sc-head"><h2 id="h-roles">Для кого: две роли</h2></div>
        <div class="sc-main">
          <div class="sc-roles">
            <div class="sc-role">
              <span class="sc-role__icon"><Iconsax name="teacher-bold" size={28}/></span>
              <h3>Педагог</h3>
              <p class="sc-role__goal">Вести журнал, создавать задания и тесты, назначать материалы из библиотеки.</p>
              <ul><li>Мало времени между уроками</li><li>Разный уровень цифровых навыков</li><li>Страх ошибиться на глазах у класса</li></ul>
            </div>
            <div class="sc-role">
              <span class="sc-role__icon"><Iconsax name="building-bold" size={28}/></span>
              <h3>Администратор школы</h3>
              <p class="sc-role__goal">Настроить школу в платформе, завести педагогов и классы, следить за внедрением.</p>
              <ul><li>Отвечает за всю школу сразу</li><li>Редкие, но сложные сценарии</li><li>Вопросы коллег идут к нему</li></ul>
            </div>
          </div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-personas">
        <div class="sc-head"><h2 id="h-personas">Персоны</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Аудитория среднего и старшего возраста. Многие начинали работать задолго до цифровых сервисов.</p>
          <div class="sc-personas">
            {personas.map((p, pi) => (
              <article class="sc-persona" data-anim="once" style={`--d:${pi * .15}s`}>
                <header class="sc-persona__head">
                  <img class="sc-persona__ava" src={img(p.ava)} alt="" width="72" height="72" loading="lazy" decoding="async"/>
                  <span><h3>{p.name}</h3><small>{p.meta}</small></span>
                </header>
                <blockquote class="sc-persona__quote"><Iconsax name="quote-up-bold" size={20}/><p>{p.quote}</p></blockquote>
                <div class="sc-persona__cols">
                  <div><p class="sc-persona__cap">Хочет</p><ul>{p.want.map((t) => <li><Iconsax name="tick-circle-bold" size={18}/>{t}</li>)}</ul></div>
                  <div><p class="sc-persona__cap">Мешает</p><ul class="is-block">{p.block.map((t) => <li><Iconsax name="danger-bold" size={18}/>{t}</li>)}</ul></div>
                </div>
                <footer class="sc-persona__foot">
                  <div><p class="sc-persona__cap">Цифровые навыки</p><span class="sc-persona__meter" style={`--n:${p.skill}`}>{[0, 1, 2, 3, 4].map((k) => <i style={`--k:${k}`}></i>)}</span></div>
                  <div><p class="sc-persona__cap">Где работает</p><span class="sc-persona__chips">{p.where.map((w) => <span>{w}</span>)}</span></div>
                </footer>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-research">
        <div class="sc-head"><h2 id="h-research">Исследование</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Мы поговорили с педагогами и администраторами и разобрали обращения в поддержку. Вот что мешало им начать работать.</p>
          <figure class="sc-pains" data-anim="once">
            <div class="sc-pains__head" aria-hidden="true"><span>Боль</span><span></span><span>Решение</span></div>
            <ul>
              {pains.map((p, i) => <li style={`--i:${i}`}>
                <blockquote class="sc-pq"><Iconsax name="quote-up-bold" size={20}/><p>{p.quote}</p><cite>{p.who}</cite></blockquote>
                <span class="sc-pains__arrow" aria-hidden="true"><Iconsax name="arrow-right-linear" size={24}/></span>
                <div class="sc-fix"><Iconsax name="lamp-on-bold" size={20}/><strong>{p.idea}</strong><small>{p.note}</small></div>
              </li>)}
            </ul>
          </figure>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-principles">
        <div class="sc-head"><h2 id="h-principles">Принципы</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Мы выбрали лонгрид: он открывается на любом устройстве и подстраивается под экран. Видео и PDF-конспект встроены в урок, поэтому каждый проходит его так, как ему удобно, а конспект остаётся памяткой, к которой можно вернуться через месяц. Видео и конспекты лежат на CDN и быстро загружаются даже при слабом интернете.</p>
          <ol class="sc-principles">
            <li class="sc-pr">
              <div class="sc-pr__text"><h3>Одна мысль на экран</h3><p>Каждый блок урока отвечает на один вопрос.</p></div>
              <div class="sc-scale" style="--base:960px"><div class="sc-pr__stage pr-sys ui" data-anim aria-hidden="true">
                <div class="pr-sys__head"><p class="pr-sys__h">Подсистемы Цифровой платформы для школ</p><p class="pr-sys__p">Подсистемы — это инструменты внутри Цифровой платформы для школ, которые помогают организовать образовательный процесс в рамках одной платформы.</p></div>
                <ul class="pr-sys__grid">
                  <li class="pr-sys__main"><span class="pr-sys__badge">В этом уроке</span><span><b>Тесты</b><small>Оценка знаний</small></span></li>
                  {subsystems.map(([t, c], i) => <li class="pr-sys__item" style={`--i:${i}`}><b>{t}</b><small>{c}</small></li>)}
                </ul>
              </div></div>
            </li>
            <li class="sc-pr">
              <div class="sc-pr__text"><h3>Визуальный сторителлинг</h3><p>Типы заданий показываем схемой, а не описанием.</p></div>
              <div class="sc-scale" style="--base:960px"><div class="sc-pr__stage pr-sl" data-anim data-slider aria-roledescription="слайдер" aria-label="Примеры типов заданий" role="region">
                <div class="pr-sl__view">
                  <div class="pr-sl__track" data-sl-track>
                    {tasks.map(([t, d], i) => (
                      <div class="pr-sl__slide" role="group" aria-roledescription="слайд" aria-label={`${i + 1} из ${tasks.length}`}>
                        <div class="pr-sl__text"><p class="pr-sl__h">{t}</p><p>{d}</p></div>
                        <div class="pr-sl__frame"><img src={img(`task-${i + 1}.svg`)} alt="" width="1100" height="620" loading="lazy" decoding="async" /></div>
                      </div>
                    ))}
                  </div>
                </div>
                <div class="pr-sl__bar">
                  <span class="pr-sl__count" aria-live="polite" data-sl-count>1 / {tasks.length}</span>
                  <div class="pr-sl__btns">
                    <button type="button" class="pr-sl__btn" aria-label="Предыдущий тип задания" data-sl-prev><Iconsax name="arrow-left2-linear" size={22}/></button>
                    <button type="button" class="pr-sl__btn" aria-label="Следующий тип задания" data-sl-next><Iconsax name="arrow-right2-linear" size={22}/></button>
                  </div>
