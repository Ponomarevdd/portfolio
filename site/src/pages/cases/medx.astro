---
import { siteUrl } from '../../utils/url';
import BackLink from '../../components/BackLink.astro';
import Page from '../../layouts/Page.astro';
import ActionButton from '../../components/ActionButton.astro';
import Iconsax from '../../components/Iconsax.astro';
import '../../styles/school-case.css';
import '../../styles/medx-case.css';

// Фрагменты макетов из канваса «MedX — Статья» (tools/medx-extract.py)
const raw = import.meta.glob('../../data/medx/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const art = (name: string) => raw[`../../data/medx/${name}.html`].replaceAll('__IMG__', siteUrl('/images/medx')!);

// Шапка: гены SARS-CoV-2 в упрощённом виде (название, доля длины, цвет, светлая подпись)
const genes: [string, number, string, boolean][] = [['ORF1a', 90, '#e8f3ee', false], ['ORF1b', 54, '#cfe3d8', false], ['S', 26, '#3b876a', true], ['E', 8, '#c9744a', true], ['M', 12, '#6f8fa3', true], ['N', 18, '#d8b45c', false]];
// Лонгрид в действии: счётчик «Прочитано» меняет анимация (medx-case.ts), пункты содержания без выделения
const read = (k: number) => `Прочитано ${k} из 8`;
const actLongread = art('longread')
  .replace('<p style="font-size: 15px; line-height: 24px; color: #60716a;">Прочитано 3 из 8</p>',
    `<p style="font-size: 15px; line-height: 24px; color: #60716a;" data-dyn="mx-read" data-dyn-values="${Array.from({ length: 9 }, (_, k) => read(k)).join('|')}">${read(0)}</p>`)
  .replace('<div style="width: 72px; height: 8px; border-radius: 4px; background: #3b876a;"></div>', '<div class="mx-act__bar"></div>')
  .replace(' aria-current="true" style="background: #e8f3ee; color: #3b876a; font-weight: 500;"', '');
if (!actLongread.includes('mx-act__bar') || !actLongread.includes('data-dyn=') || actLongread.includes('aria-current')) throw new Error('лонгрид в действии: разметка содержания изменилась');
// Отзывчивая вёрстка: содержание берём из макета лонгрида как есть, текущий пункт — «Хирургическая терапия»
const lr = art('longread');
const respToc = lr.slice(lr.indexOf('<nav'), lr.indexOf('</nav>') + 6)
  .replace('<nav aria-label="Содержание статьи" style="', '<nav class="mr-toc" style="')
  .replace(' aria-current="true" style="background: #e8f3ee; color: #3b876a; font-weight: 500;"', '')
  .replace('<span class="toc-it">Хирургическая терапия</span>', '<span class="toc-it" style="background: #e8f3ee; color: #3b876a; font-weight: 500;">Хирургическая терапия</span>')
  .replace('Прочитано 3 из 8', 'Прочитано 5 из 8').replace('width: 72px; height: 8px;', 'width: 62.5%; height: 8px;');
if (!respToc.includes('mr-toc') || !respToc.includes('Прочитано 5 из 8') || !respToc.includes('62.5%') || respToc.includes('aria-current')) throw new Error('отзывчивая вёрстка: разметка содержания в макете изменилась');
// Схемы идут парами примерно одинаковой высоты: в ряду по две, фреймы в паре выравниваются по более высокой
const schemes = [
  ['fig-spike', 'Как вирус проникает в клетку'],
  ['fig-hosts', 'Животные — источники заражения'],
  ['fig-genome', 'Геном SARS-CoV-2'],
  ['fig-genera', 'Роды коронавирусов и их хозяева'],
  ['fig-mutations', 'Как вирус летучих мышей научился заражать человека'],
  ['fig-orvi', 'Этиологическая структура ОРВИ в сезоне 2018–2019 в России'],
];
const complex = [
  ['fig-structure', 'Строение коронавируса'],
  ['fig-bats', 'Где обитают подковоносы — носители SARS-подобных вирусов'],
  ['fig-phylo', 'Родственные связи бетакоронавирусов'],
  ['fig-simplot', 'Сходство геномов с SARS-CoV-2'],
];
---
<Page title="Medx.pro: лонгриды о вакцинации">
  <article class="sc mx">
    <header class="page-heading sc-cover">
      <BackLink href={siteUrl('/work/')} label="Все работы"/>
      <div class="sc-cover__grid">
        <div class="sc-cover__text">
          <h1>Medx.pro: лонгриды о вакцинации</h1>
          <p class="sc-cover__lead">Курс интерактивных лонгридов о вакцинации от COVID-19 для врачей и медицинского персонала: показания, сроки и противопоказания.</p>
        </div>
        <div class="mx-hero" role="img" aria-label="Блоки лонгрида: обложка «Принципы работы векторных вакцин», этапы хирургической терапии, геном SARS-CoV-2, плашка «Важно» и содержание">
          <div class="mx-hero__scene mx-art" aria-hidden="true">
            <div class="mh-slot" style="--x:10px;--y:44px;--r:-4deg;z-index:2;--d:0s"><div class="mh-card mh-cover" style="--in:0s"><img src={siteUrl('/images/medx/cover-vector.webp')} alt="" width="900" height="506"><p>Принципы работы векторных вакцин</p></div></div>
            <div class="mh-slot" style="--x:300px;--y:16px;--r:3deg;z-index:3;--d:-1.5s"><div class="mh-card mh-time" style="--in:.15s"><p class="mh-t">Хирургическая терапия</p><div class="mh-line"><i></i><i></i><i></i><em></em><b>За 2 недели до операции</b><b>Операция</b><b>После восстановления</b></div></div></div>
            <div class="mh-slot" style="--x:316px;--y:198px;--r:-2deg;z-index:4;--d:-3s"><div class="mh-card mh-gen" style="--in:.3s"><p class="mh-gt">Геном SARS-CoV-2</p><div class="mh-genes">{genes.map(([n, w, c, light]) => <span style={`flex:${w};background:${c}${light ? ';color:#fff' : ''}`}>{w > 10 ? n : ''}</span>)}</div></div></div>
            <div class="mh-slot" style="--x:36px;--y:262px;--r:2.5deg;z-index:3;--d:-4.5s"><div class="mh-card mh-note" style="--in:.45s"><p class="mh-nt"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path transform="translate(2 1)" fill="#75462f" d="M18.26 4.235 L11.72 0.462 C10.65 -0.154 9.33 -0.154 8.26 0.462 L1.73 4.235 C0.66 4.851 0 5.995 0 7.238 L0 14.762 C0 15.994 0.66 17.138 1.73 17.765 L8.27 21.538 C9.33 22.154 10.65 22.154 11.73 21.538 L18.27 17.765 C19.34 17.149 20 16.005 20 14.762 L20 7.238 C19.99 5.995 19.33 4.862 18.26 4.235 Z M9.17 6.325 C9.17 5.874 9.54 5.5 9.99 5.5 C10.45 5.5 10.82 5.874 10.82 6.325 L10.82 12.1 C10.82 12.551 10.45 12.925 9.99 12.925 C9.54 12.925 9.17 12.551 9.17 12.1 Z M9.99 14.6 a1.1 1.1 0 1 1 0 2.2 a1.1 1.1 0 1 1 0 -2.2 Z"/></svg>Важно</p><p class="mh-nb">Место введения вакцины должно быть за пределами облучаемой зоны</p></div></div>
            <div class="mh-slot" style="--x:334px;--y:282px;--r:-3deg;z-index:2;--d:-2s"><div class="mh-card mh-toc" style="--in:.6s"><p class="mh-th">Содержание</p><p class="mh-read" data-dyn="mh-read" data-dyn-values={Array.from({ length: 8 }, (_, k) => read(k + 1)).join('|')}>{read(3)}</p><div class="mh-bar"><i></i></div><ul><li>В первую очередь</li><li>Особые условия</li><li>Противопоказания</li><li>Лучевая терапия</li></ul></div></div>
          </div>
        </div>
      </div>
      <dl class="sc-meta">
        <div><dt>Роль</dt><dd>Лид-дизайнер</dd></div>
        <div><dt>Период</dt><dd>Июль — сентябрь 2021</dd></div>
        <div><dt>Команда</dt><dd>2&nbsp;дизайнера под моим руководством, 2&nbsp;методиста, редактор, проджект‑менеджер, консультант от&nbsp;medx.pro</dd></div>
        <div><dt>Аудитория</dt><dd>Врачи и медицинский персонал</dd></div>
      </dl>
    </header>

    <div class="sc-body">
      <section class="sc-sec" aria-labelledby="h-context">
        <div class="sc-head"><h2 id="h-context">Контекст</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Второй год пандемии COVID-19. Вакцины только вошли в практику, клинических данных о них было немного. Медицинскому персоналу требовалось в короткие сроки освоить, каким пациентам показана вакцинация, в какие сроки её проводить и при каких состояниях она противопоказана. Для системы профессионального развития medx.pro был разработан курс по этой теме.</p>
          <div class="mx-fig mx-fig--fluid"><div class="sc-scale" style="--base:944px"><div class="mx-art" role="img" aria-label="Хронология вспышек коронавирусов: 2002, 2012 и 2019 годы" set:html={art('fig-outbreaks')}></div></div></div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-problem">
        <div class="sc-head"><h2 id="h-problem">Задача и проблема</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Исходный материал — клинические рекомендации и научные публикации: генетика вируса, механизмы заражения, схемы терапии и противопоказания. Такие тексты плотные и трудны для восприятия, а специалисту нужно быстро найти ответ и не допустить ошибки. Задача — представить этот материал в формате, удобном для изучения, и сохранить медицинскую точность.</p>
          <div class="mx-figs">
            {complex.map(([f, label]) => <div class="mx-fig"><div class="sc-scale" style="--base:1094px"><div class="mx-art" role="img" aria-label={label} set:html={art(f)}></div></div></div>)}
          </div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-me">
        <div class="sc-head"><h2 id="h-me">Что я делал</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Лид-дизайнер проекта. Разработал визуальный язык и UI-kit с нуля и отвечал за качество всех 22 лонгридов.</p>
          <ul class="sc-duties" data-anim="once">
            <li style="--i:0"><span class="sc-role__icon"><Iconsax name="brush2-bold" size={28}/></span><h3>Визуальное направление</h3><p>Определил стиль лонгридов: цвет, типографику, ритм и иерархию материала.</p></li>
            <li style="--i:1"><span class="sc-role__icon"><Iconsax name="element-4-bold" size={28}/></span><h3>UI-kit</h3><p>Разработал UI-kit с нуля: цвета, шрифты, отступы, скругления, плашки, таблицы и таймлайны. На нём собраны все лонгриды.</p></li>
            <li style="--i:2"><span class="sc-role__icon"><Iconsax name="hierarchy-bold" size={28}/></span><h3>Структура лонгрида</h3><p>Спроектировал структуру лонгрида и место в ней для видео, конспектов, интерактивов и самопроверки.</p></li>
            <li style="--i:3"><span class="sc-role__icon"><Iconsax name="diagram-bold" size={28}/></span><h3>Схемы</h3><p>Перерисовывали схемы из научных статей и клинических рекомендаций в едином стиле, понятнее и аккуратнее исходных: генетику вируса, механизмы заражения, схемы терапии.</p></li>
            <li style="--i:4"><span class="sc-role__icon"><Iconsax name="pen-tool-bold" size={28}/></span><h3>Иллюстрации</h3><p>Контролировал создание обложек лонгридов: проверял, как они выглядят и насколько точны, давал обратную связь.</p></li>
            <li style="--i:5"><span class="sc-role__icon"><Iconsax name="clipboard-text-bold" size={28}/></span><h3>Работа со смежниками</h3><p>Выстраивал подачу материала совместно с методистами и редактором, планировал выпуск с проджект‑менеджером.</p></li>
          </ul>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-roles">
        <div class="sc-head"><h2 id="h-roles">Для кого</h2></div>
        <div class="sc-main">
          <div class="mx-aud" data-anim="once">
            <div class="mx-aud__who">
              <span class="sc-role__icon"><Iconsax name="hospital-bold" size={28}/></span>
              <h3>Врачи и медицинский персонал</h3>
              <p>Определить, кому и когда показана вакцинация, и учесть противопоказания.</p>
            </div>
            <ul class="mx-aud__facts">
              <li style="--i:0"><span class="sc-role__icon"><Iconsax name="clock-bold" size={24}/></span><p>Ограниченное время между приёмами</p></li>
              <li style="--i:1"><span class="sc-role__icon"><Iconsax name="document-text-bold" size={24}/></span><p>Данные о вакцинах регулярно обновляются</p></li>
              <li style="--i:2"><span class="sc-role__icon"><Iconsax name="health-bold" size={24}/></span><p>Ошибка напрямую влияет на здоровье пациента</p></li>
            </ul>
          </div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-schemes">
        <div class="sc-head"><h2 id="h-schemes">Схема вместо абзаца</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Генетика вируса, эпидемиология и механизмы заражения представлены в лонгридах схемами. Каждая схема отвечает на один вопрос из текста.</p>
          <div class="mx-figs">
            {schemes.map(([f, label]) => <div class="mx-fig"><div class="sc-scale" style="--base:1094px"><div class="mx-art" role="img" aria-label={label} set:html={art(f)}></div></div></div>)}
          </div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-ds">
        <div class="sc-head"><h2 id="h-ds">Дизайн-система</h2></div>
        <div class="sc-main">
          <p class="sc-lead">UI-kit разработан с нуля: цвета, шрифты, отступы, скругления, плашки и схемы. На нём собраны все 22 лонгрида.</p>
          <div class="sc-ds">
            <div class="sc-ds__card">
              <h3>Два шрифта</h3>
              <p class="sc-font" aria-hidden="true">PT Serif</p>
              <p class="mx-font2" aria-hidden="true">Manrope</p>
              <ul class="sc-weights">
                <li style="font-family:'PT Serif',serif"><b>Serif</b>Заголовки статьи и разделов</li>
                <li style="font-family:Manrope,sans-serif"><b>Sans</b>Текст, плашки, содержание</li>
              </ul>
            </div>
            <div class="sc-ds__card" data-anim>
              <h3>Цвета</h3>
              <div class="sc-tokens" aria-hidden="true">
                {[['Акцент', '#3B876A', 1], ['Мятный', '#E8F3EE'], ['Заголовки', '#173D34', 1], ['Бежевый', '#F7F4EE'], ['Важно', '#FAEBDD'], ['Текст', '#344A43', 1], ['Итоги', '#123E34', 1]].map(([n, c, dark], i) => <span class={dark ? 'is-dark' : undefined} style={`--c:${c};--i:${i}`}>{n}<small>{c}</small></span>)}
              </div>
            </div>
            <div class="sc-ds__card sc-ds__card--stack" data-anim>
              <h3>Лонгрид из блоков</h3>
              <div class="sc-stack" aria-hidden="true">
                <span class="a-stack" style="animation-delay:0s">Шапка и содержание</span>
                <span class="a-stack sc-stack--tip" style="animation-delay:.25s">Информационные плашки</span>
                <span class="a-stack" style="animation-delay:.5s">Карточки и таблицы</span>
                <span class="a-stack" style="animation-delay:.75s">Схемы и таймлайны</span>
                <span class="a-stack" style="animation-delay:1s">Аккордеоны и слайдеры</span>
              </div>
            </div>
          </div>
          <ul class="sc-stats sc-stats--ds">
            <li><strong data-count="45" data-suffix="+">45+</strong><span>компонентов в UI-kit</span></li>
            <li><strong data-count="22">22</strong><span>лонгрида в едином стиле</span></li>
            <li><strong data-count="50" data-suffix="+">50+</strong><span>сложных схем</span></li>
          </ul>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-resp">
        <div class="sc-head"><h2 id="h-resp">Отзывчивая вёрстка</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Лонгрид подстраивается под любую ширину экрана: от монитора до телефона.</p>
          <div class="sc-scale" style="--base:1488px"><figure class="sc-resp mx-resp" data-anim>
            <div class="sc-resp__stage">
              <div class="sc-resp__frame" role="img" aria-label="Раздел лонгрида «Хирургическая терапия» с содержанием сужается от широкого экрана до телефона">
                <div class="rs-bar"><i></i><i></i><i></i></div>
                <div class="mr mx-art">
                  <Fragment set:html={respToc}/>
                  <div class="mr-art">
                    <h3 class="h2">Хирургическая терапия</h3>
                    <p class="p mr-lead">1. Вакцинация при оперативном вмешательстве</p>
                    <div class="mr-stages">
                      <div class="mr-stage mr-stage--before">
                        <p class="mr-stage__k">До операции</p>
                        <p class="mr-stage__t">За 2 недели до операции</p>
                        <p class="p">Чтобы во время и после операции не развились побочные реакции от вакцинации</p>
                      </div>
                      <div class="mr-op">
                        <p>Оперативное вмешательство</p>
                        <svg viewBox="0 0 144 24" aria-hidden="true"><path transform="translate(0 4)" d="M0 8 H140 M140 8 L132 0 M140 8 L132 16" fill="none" stroke="#3b876a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <svg class="mr-op__down" viewBox="0 0 24 40" aria-hidden="true"><path d="M12 2 V37 M12 37 L4 29 M12 37 L20 29" fill="none" stroke="#3b876a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                      </div>
                      <div class="mr-stage">
                        <p class="mr-stage__k">После операции</p>
                        <p class="mr-stage__t">После полного восстановления</p>
                        <p class="p">Чтобы избежать наслоения побочных реакций от вакцинации и осложнений в постоперационный период</p>
                      </div>
                    </div>
                    <h3 class="h2 mr-h2">Противоопухолевая терапия</h3>
                    <ol class="mr-time">
                      <li><h4>До начала терапии</h4><p class="p">За 2 недели до начала терапии вакцинация должна быть полностью завершена</p></li>
                      <li><h4>Во время терапии</h4><p class="p">За 1 неделю до введения препарата при химиотерапии и таргетной терапии вакцинация должна быть завершена</p></li>
                      <li><h4>После терапии</h4><p class="p">Вакцинация с учетом стандартных факторов риска</p></li>
                    </ol>
                  </div>
                </div>
              </div>
            </div>
          </figure></div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-longread">
        <div class="sc-head"><h2 id="h-longread">Лонгрид в действии</h2></div>
        <div class="sc-main">
          <div class="sc-scale" style="--base:1440px"><div class="mx-frame mx-act" data-anim>
            <div class="mx-act__view"><div class="mx-art" role="img" aria-label="Лонгрид «Вакцинация онкологических пациентов»: прокрутка и переход по содержанию" set:html={actLongread}></div></div>
            <span class="mx-cursor" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M5 3.2v15.4c0 .5.6.8 1 .4l3.6-3.4 2.4 5.5c.2.4.6.5 1 .4l2-.9c.4-.2.5-.6.4-1l-2.4-5.4 4.9-.3c.5 0 .8-.6.4-1L6 2.8c-.4-.3-1-.1-1 .4Z" fill="#173d34" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg></span>
          </div></div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-lms">
        <div class="sc-head"><h2 id="h-lms">Концепт «Моё обучение»</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Вокруг лонгридов был разработан концепт личного кабинета: продолжение с места остановки, учебный план, сохранённые материалы, видео и рекомендации по специализации.</p>
