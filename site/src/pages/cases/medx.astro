---
import { siteUrl } from '../../utils/url';
import BackLink from '../../components/BackLink.astro';
import Page from '../../layouts/Page.astro';
import ActionButton from '../../components/ActionButton.astro';
import Iconsax from '../../components/Iconsax.astro';
import '../../styles/school-case.css';
import '../../styles/medx-case.css';

// Фрагменты макетов из канваса «MedX — Статья» (tools/medx-extract.py)
const raw = import.meta.glob('../../data/medx/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const art = (name: string) => raw[`../../data/medx/${name}.html`].replaceAll('__IMG__', siteUrl('/images/medx')!);

const schemes = [
  ['fig-spike', 'Как вирус проникает в клетку'],
  ['fig-mutations', 'Как вирус летучих мышей научился заражать человека'],
  ['fig-genera', 'Роды коронавирусов и их хозяева'],
  ['fig-hosts', 'Животные — источники заражения'],
  ['fig-genome', 'Геном SARS-CoV-2'],
  ['fig-lineages', 'Линии SARS-CoV-2'],
];
// Лонгрид в действии: счётчик «Прочитано» меняет анимация (medx-case.ts), пункты содержания без выделения
const read = (k: number) => `Прочитано ${k} из 8`;
const actLongread = art('longread')
  .replace('<p style="font-size: 15px; line-height: 24px; color: #60716a;">Прочитано 3 из 8</p>',
    `<p style="font-size: 15px; line-height: 24px; color: #60716a;" data-dyn="mx-read" data-dyn-values="${Array.from({ length: 9 }, (_, k) => read(k)).join('|')}">${read(0)}</p>`)
  .replace('<div style="width: 72px; height: 8px; border-radius: 4px; background: #3b876a;"></div>', '<div class="mx-act__bar"></div>')
  .replace(' aria-current="true" style="background: #e8f3ee; color: #3b876a; font-weight: 500;"', '');
if (!actLongread.includes('mx-act__bar') || !actLongread.includes('data-dyn=') || actLongread.includes('aria-current')) throw new Error('лонгрид в действии: разметка содержания изменилась');
// Схемы из лонгрида «Истоки пандемии»: показывают, насколько плотный исходный материал
const complex = [
  ['fig-structure', 'Строение коронавируса'],
  ['fig-simplot', 'Сходство геномов с SARS-CoV-2'],
  ['fig-phylo', 'Родственные связи бетакоронавирусов'],
  ['fig-bats', 'Где обитают подковоносы — носители SARS-подобных вирусов'],
];
---
<Page title="MedX.pro">
  <article class="sc mx">
    <header class="page-heading sc-cover">
      <BackLink href={siteUrl('/work/')} label="Все работы"/>
      <div class="sc-cover__grid">
        <div class="sc-cover__text">
          <h1>MedX.pro</h1>
          <p class="sc-cover__lead">Курс интерактивных лонгридов о вакцинации от COVID-19 для врачей и медицинского персонала: показания, сроки и противопоказания.</p>
        </div>
        <div class="mx-hero" role="img" aria-label="Начало лонгрида «Вакцинация онкологических пациентов»">
          <div class="sc-scale" style="--base:1440px"><div class="mx-art" set:html={art('longread')}></div></div>
        </div>
      </div>
      <dl class="sc-meta">
        <div><dt>Роль</dt><dd>Лид-дизайнер</dd></div>
        <div><dt>Период</dt><dd>Июль — сентябрь 2021</dd></div>
        <div><dt>Команда</dt><dd>3&nbsp;дизайнера под моим руководством, 3&nbsp;методиста, редактор, проджект‑менеджер</dd></div>
        <div><dt>Аудитория</dt><dd>Врачи и медицинский персонал</dd></div>
      </dl>
    </header>

    <div class="sc-body">
      <section class="sc-sec" aria-labelledby="h-context">
        <div class="sc-head"><h2 id="h-context">Контекст</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Второй год пандемии COVID-19. Вакцины только вошли в практику, клинических данных о них было немного. Медицинскому персоналу требовалось в короткие сроки освоить, каким пациентам показана вакцинация, в какие сроки её проводить и при каких состояниях она противопоказана. Для системы профессионального развития MedX.pro был разработан курс по этой теме.</p>
          <div class="mx-fig mx-fig--fluid"><div class="sc-scale" style="--base:944px"><div class="mx-art" role="img" aria-label="Хронология вспышек коронавирусов: 2002, 2012 и 2019 годы" set:html={art('fig-outbreaks')}></div></div></div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-problem">
        <div class="sc-head"><h2 id="h-problem">Задача и проблема</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Исходный материал — клинические рекомендации и научные публикации: генетика вируса, механизмы заражения, схемы терапии и противопоказания. Такие тексты плотные и трудны для восприятия, а специалисту нужно быстро найти ответ и не допустить ошибки. Задача — представить этот материал в формате, удобном для изучения, и сохранить медицинскую точность.</p>
          <div class="mx-figs">
            {complex.map(([f, label]) => <div class="mx-fig"><div class="sc-scale" style="--base:1094px"><div class="mx-art" role="img" aria-label={label} set:html={art(f)}></div></div></div>)}
          </div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-me">
        <div class="sc-head"><h2 id="h-me">Что я делал</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Лид-дизайнер проекта. Разработал визуальный язык и UI-kit с нуля и отвечал за качество всех 22 лонгридов.</p>
          <ul class="sc-duties" data-anim="once">
            <li style="--i:0"><span class="sc-role__icon"><Iconsax name="brush2-bold" size={28}/></span><h3>Визуальное направление</h3><p>Определил стиль лонгридов: цвет, типографику, ритм и иерархию материала.</p></li>
            <li style="--i:1"><span class="sc-role__icon"><Iconsax name="element-4-bold" size={28}/></span><h3>UI-kit</h3><p>Разработал UI-kit с нуля: цвета, шрифты, отступы, скругления, плашки, таблицы и таймлайны. На нём собраны все лонгриды.</p></li>
            <li style="--i:2"><span class="sc-role__icon"><Iconsax name="hierarchy-bold" size={28}/></span><h3>Структура лонгрида</h3><p>Спроектировал структуру лонгрида и место в ней для видео, конспектов, интерактивов и самопроверки.</p></li>
            <li style="--i:3"><span class="sc-role__icon"><Iconsax name="diagram-bold" size={28}/></span><h3>Схемы</h3><p>Переводил сложные медицинские данные в схемы: генетику вируса, механизмы заражения, рекомендации по терапии.</p></li>
            <li style="--i:4"><span class="sc-role__icon"><Iconsax name="pen-tool-bold" size={28}/></span><h3>Иллюстрации</h3><p>Создавал обложки лонгридов в Photoshop с медицинской и анатомической точностью.</p></li>
            <li style="--i:5"><span class="sc-role__icon"><Iconsax name="clipboard-text-bold" size={28}/></span><h3>Работа со смежниками</h3><p>Выстраивал подачу материала совместно с методистами и редактором, планировал выпуск с руководителем проекта.</p></li>
          </ul>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-roles">
        <div class="sc-head"><h2 id="h-roles">Для кого</h2></div>
        <div class="sc-main">
          <div class="mx-aud" data-anim="once">
            <div class="mx-aud__who">
              <span class="sc-role__icon"><Iconsax name="hospital-bold" size={28}/></span>
              <h3>Врачи и медицинский персонал</h3>
              <p>Определить, кому и когда показана вакцинация, и учесть противопоказания.</p>
            </div>
            <ul class="mx-aud__facts">
              <li style="--i:0"><span class="sc-role__icon"><Iconsax name="clock-bold" size={24}/></span><p>Ограниченное время между приёмами</p></li>
              <li style="--i:1"><span class="sc-role__icon"><Iconsax name="document-text-bold" size={24}/></span><p>Данные о вакцинах регулярно обновляются</p></li>
              <li style="--i:2"><span class="sc-role__icon"><Iconsax name="health-bold" size={24}/></span><p>Ошибка напрямую влияет на здоровье пациента</p></li>
            </ul>
          </div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-schemes">
        <div class="sc-head"><h2 id="h-schemes">Схема вместо абзаца</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Генетика вируса, эпидемиология и механизмы заражения представлены в лонгридах схемами. Каждая схема отвечает на один вопрос из текста.</p>
          <div class="mx-figs">
            {schemes.map(([f, label]) => <div class="mx-fig"><div class="sc-scale" style="--base:1094px"><div class="mx-art" role="img" aria-label={label} set:html={art(f)}></div></div></div>)}
          </div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-ds">
        <div class="sc-head"><h2 id="h-ds">Дизайн-система</h2></div>
        <div class="sc-main">
          <p class="sc-lead">UI-kit разработан с нуля: цвета, шрифты, отступы, скругления, плашки и схемы. На нём собраны все 22 лонгрида.</p>
          <div class="sc-ds">
            <div class="sc-ds__card">
              <h3>Два шрифта</h3>
              <p class="sc-font" aria-hidden="true">PT Serif</p>
              <p class="mx-font2" aria-hidden="true">Manrope</p>
              <ul class="sc-weights">
                <li style="font-family:'PT Serif',serif"><b>Serif</b>Заголовки статьи и разделов</li>
                <li style="font-family:Manrope,sans-serif"><b>Sans</b>Текст, плашки, содержание</li>
              </ul>
            </div>
            <div class="sc-ds__card" data-anim>
              <h3>Цвета</h3>
              <div class="sc-tokens" aria-hidden="true">
                {[['Акцент', '#3B876A', 1], ['Мятный', '#E8F3EE'], ['Заголовки', '#173D34', 1], ['Бежевый', '#F7F4EE'], ['Важно', '#FAEBDD'], ['Текст', '#344A43', 1], ['Итоги', '#123E34', 1]].map(([n, c, dark], i) => <span class={dark ? 'is-dark' : undefined} style={`--c:${c};--i:${i}`}>{n}<small>{c}</small></span>)}
              </div>
            </div>
            <div class="sc-ds__card sc-ds__card--stack" data-anim>
              <h3>Лонгрид из блоков</h3>
              <div class="sc-stack" aria-hidden="true">
                <span class="a-stack" style="animation-delay:0s">Шапка лонгрида</span>
                <span class="a-stack" style="animation-delay:.25s">Содержание</span>
                <span class="a-stack sc-stack--tip" style="animation-delay:.5s">Плашка «Важно»</span>
                <span class="a-stack" style="animation-delay:.75s">Таблица · Таймлайн</span>
                <span class="a-stack" style="animation-delay:1s">Схема · Итоги</span>
              </div>
            </div>
          </div>
          <ul class="sc-stats sc-stats--ds">
            <li><strong data-count="22">22</strong><span>лонгрида в едином стиле</span></li>
            <li><strong data-count="7">7</strong><span>цветов в палитре</span></li>
            <li><strong data-count="2">2</strong><span>шрифта: для заголовков и для текста</span></li>
          </ul>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-longread">
        <div class="sc-head"><h2 id="h-longread">Лонгрид в действии</h2></div>
        <div class="sc-main">
          <div class="sc-scale" style="--base:1440px"><div class="mx-frame mx-act" data-anim>
            <div class="mx-act__view"><div class="mx-art" role="img" aria-label="Лонгрид «Вакцинация онкологических пациентов»: прокрутка и переход по содержанию" set:html={actLongread}></div></div>
            <span class="mx-cursor" aria-hidden="true"><svg viewBox="0 0 24 24" width="26" height="26"><path d="M5 3.2v15.4c0 .5.6.8 1 .4l3.6-3.4 2.4 5.5c.2.4.6.5 1 .4l2-.9c.4-.2.5-.6.4-1l-2.4-5.4 4.9-.3c.5 0 .8-.6.4-1L6 2.8c-.4-.3-1-.1-1 .4Z" fill="#173d34" stroke="#fff" stroke-width="1.5" stroke-linejoin="round"/></svg></span>
          </div></div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-lms">
        <div class="sc-head"><h2 id="h-lms">Концепт «Моё обучение»</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Вокруг лонгридов был разработан концепт личного кабинета: продолжение с места остановки, учебный план, сохранённые материалы, видео и рекомендации по специализации.</p>
          <div class="sc-scale" style="--base:1440px"><div class="mx-frame"><div class="mx-art mx-art--lms" role="img" aria-label="Концепт личного кабинета «Моё обучение»" set:html={art('lms')}></div></div></div>
        </div>
      </section>

      <section class="sc-sec sc-results" aria-labelledby="h-results">
        <div class="sc-head"><h2 id="h-results">Результаты</h2></div>
        <div class="sc-main" data-anim>
          <ul class="sc-stats sc-stats--big">
            <li><strong data-count="22">22</strong><span>интерактивных лонгрида</span></li>
            <li><strong><span data-count="3">3</span> месяца</strong><span>работы над курсом</span></li>
            <li><strong><span data-count="3">3</span> формата</strong><span>лонгрид, видео и конспект</span></li>
            <li><strong>Концепт</strong><span>личного кабинета</span></li>
          </ul>
          <div class="sc-quote">
            <p>Клинические рекомендации переведены в схемы, таблицы и таймлайны без потери медицинской точности. Все 22 лонгрида собраны на одном UI-kit, а вокруг них разработан концепт личного кабинета «Моё обучение».</p>
          </div>
        </div>
      </section>
    </div>
  </article>
  <div class="action-row"><ActionButton href={siteUrl('/work/')} label="Посмотреть все работы"/></div>
</Page>
<script>import '../../scripts/medx-case';</script>
