---
import { siteUrl } from '../../utils/url';
import BackLink from '../../components/BackLink.astro';
import Page from '../../layouts/Page.astro';
import ActionButton from '../../components/ActionButton.astro';
import Iconsax from '../../components/Iconsax.astro';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/cyrillic-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/cyrillic-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/cyrillic-600.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/manrope/cyrillic-700.css';
import '@fontsource/pt-serif/latin-400.css';
import '@fontsource/pt-serif/cyrillic-400.css';
import '@fontsource/pt-serif/latin-700.css';
import '@fontsource/pt-serif/cyrillic-700.css';
import '../../styles/school-case.css';
import '../../styles/medx-case.css';

// Фрагменты макетов из канваса «MedX — Статья» (tools/medx-extract.py)
const raw = import.meta.glob('../../data/medx/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const art = (name: string) => raw[`../../data/medx/${name}.html`].replaceAll('__IMG__', siteUrl('/images/medx')!);

const schemes = [
  ['fig-spike', 'Как вирус проникает в клетку'],
  ['fig-mutations', 'Как вирус летучих мышей научился заражать человека'],
  ['fig-genera', 'Роды коронавирусов и их хозяева'],
  ['fig-genome', 'Геном SARS-CoV-2'],
  ['fig-lineages', 'Линии SARS-CoV-2'],
];
const kit = [
  ['kit-toc', 'Содержание с прогрессом'],
  ['kit-note', 'Важно'],
  ['kit-card', 'Карточка с рекомендацией'],
  ['kit-stage', 'Этап и срок'],
  ['kit-table', 'Таблица'],
  ['kit-timeline', 'Таймлайн'],
  ['kit-summary', 'Итоги'],
  ['kit-list', 'Список'],
];
---
<Page title="MedX.pro">
  <article class="sc mx">
    <header class="page-heading sc-cover">
      <BackLink href={siteUrl('/work/')} label="Все работы"/>
      <div class="sc-cover__grid">
        <div class="sc-cover__text">
          <h1>MedX.pro</h1>
          <p class="sc-cover__lead">Интерактивные лонгриды для медиков о вакцинации от COVID-19: кого прививать, когда и при каких противопоказаниях. Курс для системы профессионального развития медицинского персонала.</p>
        </div>
        <div class="mx-hero" role="img" aria-label="Начало лонгрида «Вакцинация онкологических пациентов»">
          <div class="sc-scale" style="--base:1440px"><div class="mx-art" set:html={art('longread')}></div></div>
        </div>
      </div>
      <dl class="sc-meta">
        <div><dt>Роль</dt><dd>Лид-дизайнер</dd></div>
        <div><dt>Период</dt><dd>2021–2022</dd></div>
        <div><dt>Формат</dt><dd>22 интерактивных лонгрида, видео и конспекты</dd></div>
        <div><dt>Аудитория</dt><dd>Врачи и медицинский персонал</dd></div>
      </dl>
    </header>

    <div class="sc-body">
      <section class="sc-sec" aria-labelledby="h-context">
        <div class="sc-head"><h2 id="h-context">Контекст</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Шёл второй-третий год пандемии. Вакцины от COVID-19 только появились, данных о них было мало, а медикам нужно было быстро разобраться, каким пациентам можно прививаться, когда и при каких противопоказаниях. MedX.pro — система профессионального развития медицинского персонала, и мы делали для неё курс об этом.</p>
          <div class="mx-fig"><div class="sc-scale" style="--base:944px"><div class="mx-art" role="img" aria-label="Хронология вспышек коронавирусов: 2002, 2012 и 2019 годы" set:html={art('fig-outbreaks')}></div></div></div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-problem">
        <div class="sc-head"><h2 id="h-problem">Задача и проблема</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Клинические рекомендации и научные данные о вакцинах сложные и плотные: генетика вируса, механизмы заражения, схемы терапии. А врачу между приёмами нужно быстро найти ответ и не ошибиться.</p>
          <p>Задача: превратить этот материал в лонгриды, которые медик прочитает и поймёт, и при этом не упростить его до неточности.</p>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-me">
        <div class="sc-head"><h2 id="h-me">Что я делал</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Был лид-дизайнером проекта: с нуля задал визуальный язык и UI-kit и отвечал за качество всех 22 лонгридов.</p>
          <ul class="sc-duties">
            <li><span class="sc-role__icon"><Iconsax name="brush2-bold" size={28}/></span><h3>Визуальное направление</h3><p>Определил стиль лонгридов: цвета, типографику, ритм и иерархию материала.</p></li>
            <li><span class="sc-role__icon"><Iconsax name="element-4-bold" size={28}/></span><h3>UI-kit</h3><p>Собрал UI-kit с нуля: цвета, шрифты, отступы, скругления, плашки, таблицы и таймлайны. Все лонгриды собраны на нём.</p></li>
            <li><span class="sc-role__icon"><Iconsax name="hierarchy-bold" size={28}/></span><h3>Структура лонгрида</h3><p>Спроектировал, как устроен лонгрид и как в него встроены видео, конспект, интерактивы и самопроверка.</p></li>
            <li><span class="sc-role__icon"><Iconsax name="microscope-bold" size={28}/></span><h3>Схемы</h3><p>Превращал сложные медицинские данные в схемы: генетику вируса, механизмы заражения, рекомендации по терапии.</p></li>
            <li><span class="sc-role__icon"><Iconsax name="pen-tool-bold" size={28}/></span><h3>Иллюстрации</h3><p>Делал обложки: генерация в GPT и доработка в Photoshop до медицинской и анатомической точности.</p></li>
            <li><span class="sc-role__icon"><Iconsax name="clipboard-text-bold" size={28}/></span><h3>Работа со смежниками</h3><p>Вместе с методистами и редактором выстраивал подачу материала, с проджект-менеджером планировал сроки выпуска.</p></li>
          </ul>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-roles">
        <div class="sc-head"><h2 id="h-roles">Для кого</h2></div>
        <div class="sc-main">
          <div class="sc-role mx-role">
            <span class="sc-role__icon"><Iconsax name="people-bold" size={28}/></span>
            <h3>Врачи и медицинский персонал</h3>
            <p class="sc-role__goal">Понять, кого и когда вакцинировать, и не пропустить противопоказания.</p>
            <ul><li>Мало времени между приёмами</li><li>Данные о вакцинах постоянно обновляются</li><li>Цена ошибки — здоровье пациента</li></ul>
          </div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-schemes">
        <div class="sc-head"><h2 id="h-schemes">Схема вместо абзаца</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Генетику вируса, эпидемиологию и механизмы заражения мы показывали схемами. Каждая отвечает на один вопрос из лонгрида.</p>
          <div class="mx-figs">
            {schemes.map(([f, label]) => <div class="mx-fig"><div class="sc-scale" style="--base:944px"><div class="mx-art" role="img" aria-label={label} set:html={art(f)}></div></div></div>)}
          </div>
        </div>
      </section>

      <section class="sc-sec" aria-labelledby="h-ill">
        <div class="sc-head"><h2 id="h-ill">Иллюстрации обложек</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Обложки мы генерировали в GPT. Генерация тогда ошибалась в деталях, поэтому каждую иллюстрацию дорабатывали в Photoshop, пока она не становилась медицински и анатомически точной и при этом понятной.</p>
          <div class="mx-covers">
            <div class="mx-cover">Обложка лонгрида</div>
            <div class="mx-cover">Обложка лонгрида</div>
            <div class="mx-cover">Обложка лонгрида</div>
          </div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-ds">
        <div class="sc-head"><h2 id="h-ds">Дизайн-система</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Я собрал UI-kit с нуля: цвета, шрифты, отступы, скругления, плашки и схемы. На нём собраны все 22 лонгрида.</p>
          <div class="sc-ds">
            <div class="sc-ds__card">
              <h3>Два шрифта</h3>
              <p class="sc-font" aria-hidden="true">PT Serif</p>
              <p class="mx-font2" aria-hidden="true">Manrope</p>
              <ul class="sc-weights">
                <li style="font-family:'PT Serif',serif"><b>Serif</b>Заголовки статьи и разделов</li>
                <li style="font-family:Manrope,sans-serif"><b>Sans</b>Текст, плашки, содержание</li>
              </ul>
            </div>
            <div class="sc-ds__card">
              <h3>Цвета</h3>
              <div class="sc-tokens" aria-hidden="true">
                {[['Акцент', '#3B876A', 1], ['Мятный', '#E8F3EE'], ['Заголовки', '#173D34', 1], ['Бежевый', '#F7F4EE'], ['Важно', '#FAEBDD'], ['Текст', '#344A43', 1], ['Итоги', '#123E34', 1]].map(([n, c, dark], i) => <span class={dark ? 'is-dark' : undefined} style={`--c:${c};--i:${i}`}>{n}<small>{c}</small></span>)}
              </div>
            </div>
            <div class="sc-ds__card">
              <h3>Отступы</h3>
              <ul class="sc-weights">
                {[['60', 'между разделами'], ['44', 'между подразделами'], ['36', 'заголовок → текст'], ['28', 'внутри карточки'], ['20', 'между абзацами'], ['10', 'пункты списка']].map(([v, l]) => <li><b>{v}</b>{l}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-anatomy">
        <div class="sc-head"><h2 id="h-anatomy">Анатомия лонгрида</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Плашки, из которых собирается любой лонгрид.</p>
          <div class="mx-kit">
            {kit.map(([f, label]) => <div class="sc-part"><div class="sc-part__stage"><div class="sc-scale" style="--base:640px"><div class="mx-art" aria-hidden="true" set:html={art(f)}></div></div></div><h3>{label}</h3></div>)}
          </div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-longread">
        <div class="sc-head"><h2 id="h-longread">Лонгрид</h2></div>
        <div class="sc-main">
          <div class="sc-scale" style="--base:1440px"><div class="mx-frame mx-frame--clip" style="--clip:2600px"><div class="mx-art" role="img" aria-label="Лонгрид «Вакцинация онкологических пациентов»" set:html={art('longread')}></div></div></div>
        </div>
      </section>

      <section class="sc-sec sc-sec--wide" aria-labelledby="h-lms">
        <div class="sc-head"><h2 id="h-lms">Концепт «Моё обучение»</h2></div>
        <div class="sc-main">
          <p class="sc-lead">Вокруг лонгридов мы придумали личный кабинет: продолжить с того места, где остановился, учебный план, сохранённые материалы, видео и рекомендации по специализации.</p>
          <div class="sc-scale" style="--base:1440px"><div class="mx-frame"><div class="mx-art mx-art--lms" role="img" aria-label="Концепт личного кабинета «Моё обучение»" set:html={art('lms')}></div></div></div>
        </div>
      </section>

      <section class="sc-sec sc-results" aria-labelledby="h-results">
        <div class="sc-head"><h2 id="h-results">Результаты</h2></div>
        <div class="sc-main">
          <ul class="sc-stats sc-stats--big">
            <li><strong>22</strong><span>интерактивных лонгрида</span></li>
            <li><strong>С нуля</strong><span>UI-kit проекта</span></li>
            <li><strong>3 формата</strong><span>лонгрид, видео и конспект</span></li>
            <li><strong>Концепт</strong><span>личного кабинета</span></li>
          </ul>
          <div class="sc-quote">
            <p>Все 22 лонгрида собраны на одном UI-kit: схемы, интерактивы, самопроверки, видео и конспекты. Обложки остались медицински и анатомически точными и при этом понятными для аудитории.</p>
          </div>
        </div>
      </section>
    </div>
  </article>
  <div class="action-row"><ActionButton href={siteUrl('/work/')} label="Посмотреть все работы"/></div>
</Page>
<script>import '../../scripts/medx-case';</script>
