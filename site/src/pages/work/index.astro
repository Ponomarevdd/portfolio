---
import BackLink from '../../components/BackLink.astro';
import Page from '../../layouts/Page.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { allProjects } from '../../data/projects';
---
<Page title="Мои работы">
  <header class="page-heading"><BackLink/><h1>Мои работы</h1><p>Сайты, интерфейсы и визуальные истории.</p></header>
  <section class="work" id="work" aria-label="Мои работы">{allProjects.map(project => <ProjectCard project={project}/>)}</section>
</Page>
