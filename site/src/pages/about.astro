---
import Page from '../layouts/Page.astro';
import BackLink from '../components/BackLink.astro';
import Iconsax from '../components/Iconsax.astro';
import '../styles/about.css';

const specs = [
  ['Опыт', '5 лет'],
  ['Из них лидом', '2 года'],
  ['Команда', 'до 7 дизайнеров'],
  ['Специализация', 'EdTech, e-learning'],
  ['Формат', 'удалённо или гибрид'],
  ['Город', 'Москва'],
];

const stack = [
  { title: 'В комплекте', items: ['Figma', 'Claude', 'Codex'] },
  { title: 'Дополнительно', items: ['Adobe Photoshop', 'Adobe Illustrator', 'Notion'] },
  { title: 'Методы', items: ['User Flow', 'CJM', 'Вайрфреймы', 'Прототипирование', 'Дизайн-системы', 'Дизайн-ревью'] },
];
---
<Page title="Обо мне">
  <div class="about-page">
    <div class="about-back"><BackLink/></div>
    <section class="about-hero" aria-labelledby="about-title">
      <div class="about-photo" role="img" aria-label="Место для фотографии Дмитрия">
        <span class="about-photo-initial" aria-hidden="true">Д.</span>
      </div>
      <div class="about-intro">
        <h1 id="about-title">Дмитрий<br/>Пономарев</h1>
        <p>Senior UI/UX-дизайнер, больше пяти лет в продуктовом дизайне. Проектирую сложные цифровые продукты: образовательные платформы, интерактивные сервисы и e-learning.</p>
      </div>
    </section>
    <div class="about-text">
      <p>Два года руководил отделом дизайна в Pulsar Production. Вёл команду из <span class="about-nw">5–7</span> дизайнеров, переводил бизнес-требования в продуктовые задачи и UX/UI-решения, участвовал в продуктовой логике и roadmap, выстраивал процессы с разработкой и QA.</p>
      <p>До этого три года был Middle UI/UX-дизайнером в той же студии: делал интерактивные продукты, обучающие модули и тесты, готовил макеты к разработке и развивал дизайн-систему.</p>
      <p>Начинаю со сценариев и информационной архитектуры: User Flow, CJM, вайрфреймы. Дальше прототипы в Figma, интерфейсы и дизайн-система, которая держит продукт консистентным. Люблю чистую типографику, отзывчивую вёрстку и движение, у которого есть смысл.</p>
    </div>
    <section class="about-card" aria-labelledby="card-title">
      <div class="about-card__top">
        <span class="about-card__stock"><span class="about-card__dot" aria-hidden="true"></span>В наличии · открыт к предложениям</span>
        <span class="about-card__sku">Арт. UI/UX-2020</span>
      </div>
      <h2 id="card-title">Senior UI/UX-дизайнер</h2>
      <div class="about-card__grid">
        <div>
          <h3>Характеристики</h3>
          <dl class="about-card__specs">
            {specs.map(([key, value]) => <div><dt>{key}</dt><dd>{value}</dd></div>)}
          </dl>
        </div>
        <div class="about-card__stack">
          {stack.map((group) => (
            <div>
              <h3>{group.title}</h3>
              <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
            </div>
          ))}
        </div>
      </div>
      <div class="about-card__buy">
        <p><span>Цена</span> по договорённости</p>
        <button type="button" data-contact-open aria-haspopup="dialog" aria-controls="contact-dialog">Связаться <Iconsax name="arrow" size={18} rotate={45} /></button>
      </div>
    </section>
  </div>
</Page>
