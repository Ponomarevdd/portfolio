---
// Обложка «Joy Division»: мозаика экранов концепта с главной страницей группы в центре (та же картинка, что в «Контексте» кейса).
import { siteUrl } from '../utils/url';
interface Props { href?: string; label: string }
const { href, label } = Astro.props;
const Tile = href ? 'a' : 'div';
---
<Tile href={siteUrl(href)} class="project__cover jdv" aria-label={label}>
  <img src={siteUrl('/images/joy-division/mosaic.webp')} alt="" width="2214" height="1662" loading="lazy" decoding="async">
</Tile>
<style is:global>
.jdv { display: block; position: relative; overflow: hidden; background: #2f2f2f; }
.jdv img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 52%; }
</style>
