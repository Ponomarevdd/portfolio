---
import { contacts } from '../data/contacts';
import Iconsax from './Iconsax.astro';
import '../styles/contact.css';
---
<dialog id="contact-dialog" class="contact-dialog" aria-labelledby="contact-title">
  <button class="contact-close" type="button" aria-label="Закрыть контакты"><span></span><span></span></button>
  <div class="contact-layout">
    <section class="contact-intro">
      <h2 id="contact-title">Хорошие идеи<br />начинаются<br />с разговора.</h2>
      <p class="contact-description">Расскажите, что задумали.<br />Будет интересно сделать это вместе.</p>
      <ul class="contact-direct" aria-label="Контакты">
        <li><a href={`mailto:${contacts.email}`}><span>Почта</span>{contacts.email} <Iconsax name="arrow" size={18} rotate={45} /></a></li>
        <li><a href={`https://t.me/${contacts.telegram}`} target="_blank" rel="noopener"><span>Telegram</span>@{contacts.telegram} <Iconsax name="arrow" size={18} rotate={45} /></a></li>
      </ul>
    </section>
  </div>
</dialog>
<script>
  import '../scripts/contact';
</script>
