---
import { contacts } from '../data/contacts';
import Iconsax from './Iconsax.astro';
import '../styles/contact.css';
---
<dialog id="contact-dialog" class="contact-dialog" aria-labelledby="contact-title">
  <button class="contact-close" type="button" aria-label="Закрыть контакты"><span></span><span></span></button>
  <div class="contact-layout">
    <section class="contact-intro">
      <h2 id="contact-title">Хорошие идеи начинаются с разговора.</h2>
      <p class="contact-description">Расскажите, что задумали. Будет интересно сделать это вместе.</p>
      <div class="contact-direct" aria-label="Контакты">
        <a href={`mailto:${contacts.email}`} title={contacts.email}>Почта <Iconsax name="arrow" size={18} rotate={45} /></a>
        <a href={`https://t.me/${contacts.telegram}`} target="_blank" rel="noopener" title={`@${contacts.telegram}`}>Telegram <Iconsax name="arrow" size={18} rotate={45} /></a>
      </div>
    </section>
  </div>
</dialog>
<script>
  import '../scripts/contact';
</script>
