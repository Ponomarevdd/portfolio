<canvas class="ascii-field" aria-hidden="true"></canvas>
<style>
  .ascii-field { position: absolute; z-index: 0; inset: 0 0 auto; width: 100%; height: 100vh; pointer-events: none; }
  :global(.has-ascii .gradient) { display: none; }
  /* С фоном вводка занимает почти весь первый экран, чтобы волнам было где разойтись */
  :global(.has-ascii .intro) { min-height: clamp(420px, 66vh, 680px); display: flex; align-items: center; justify-content: center; }
</style>
<script>
  import { initAsciiField } from '../scripts/ascii-field';
  const canvas = document.querySelector<HTMLCanvasElement>('.ascii-field');
  const quiet = [...document.querySelectorAll('#intro-title, .navigation')];
  const intro = document.querySelector<HTMLElement>('#intro');
  if (canvas && intro) {
    // Фон кончается вместе с вводкой и растворяется к её низу
    const fit = () => { canvas.style.height = `${intro.offsetTop + intro.offsetHeight}px`; };
    new ResizeObserver(fit).observe(intro);
    fit();
    initAsciiField(canvas, quiet);
  }
</script>
