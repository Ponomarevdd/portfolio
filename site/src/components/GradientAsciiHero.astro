---
import GradientHero from './react/GradientHero';
---
<div class="gradient-ascii-hero" aria-hidden="true"><GradientHero client:only="react" /></div>
<style>
  .gradient-ascii-hero { position: absolute; z-index: 0; inset: 0 0 auto; height: 100vh; background: var(--dark-page); overflow: hidden; pointer-events: none; }
  :global(.has-gradient-ascii .gradient) { display: none; }
  /* Пробная тёмная главная: почти чёрный фон, светлый текст */
  :global(:root.has-gradient-ascii) { --dark-page: #0e0d10; background: var(--dark-page); color: #f1f1f4; --text-secondary: #9a9ba6; }
  /* Меню: почти белое, слегка прозрачное, без матового стекла; ховер и переключатель — белая плашка */
  :global(.has-gradient-ascii .navigation) { color: #111; border-color: #fff; background: #ececefe6; backdrop-filter: none; -webkit-backdrop-filter: none; box-shadow: 0 4px 22px #00000033; }
  :global(.has-gradient-ascii .navigation__indicator) { background: #fff; box-shadow: 0 2px 10px #0000001f; }
  :global(.has-gradient-ascii .navigation a:hover), :global(.has-gradient-ascii .navigation button:hover) { background: #ffffffb3; }
  /* Пока без цвета: белая кнопка с чёрным текстом, при наведении чёрная обводка */
  :global(.has-gradient-ascii .action-button) { background: #fff; color: #111; }
  :global(.has-gradient-ascii .action-button::before) { display: none; }
  :global(.has-gradient-ascii .action-button::after) { background: #fff; box-shadow: 0 0 0 1px #111; }
  :global(.has-gradient-ascii .action-button:hover), :global(.has-gradient-ascii .action-button:focus-visible) { color: #111; }
  :global(.has-gradient-ascii .project__details h2 a:hover), :global(.has-gradient-ascii .project__details h2 a:focus-visible) { color: #fff; }
  /* Теги кейсов: белые, внутри чёрный текст и иконки */
  :global(.has-gradient-ascii .project__categories li) { background: #fff; color: #111; border-color: #fff; }
  :global(.has-gradient-ascii ::selection) { background: #ffffff40; }
  :global(.has-gradient-ascii .intro) { position: relative; min-height: clamp(340px, 50vh, 500px); padding: 48px 32px 96px; display: flex; align-items: center; justify-content: center; }
</style>
<script>
  document.documentElement.classList.add('has-gradient-ascii');
  const hero = document.querySelector<HTMLElement>('.gradient-ascii-hero');
  const intro = document.querySelector<HTMLElement>('#intro');
  if (hero && intro) {
    // Высота фона подбирается так, чтобы приветствие стояло в оранжевой полосе (~38% высоты).
    // Низ градиента может заходить на кейсы
    const title = document.querySelector<HTMLElement>('#intro-title');
    const fit = () => {
      const bottom = intro.offsetTop + intro.offsetHeight;
      const box = title?.getBoundingClientRect();
      const center = box ? box.top + scrollY + box.height / 2 : bottom / 2;
      hero.style.height = `${Math.max(bottom, Math.round(center / 0.38))}px`;
    };
    new ResizeObserver(fit).observe(intro);
    fit();
  }
</script>
