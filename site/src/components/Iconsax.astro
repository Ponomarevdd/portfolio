---
import layer from '../assets/iconsax/layer-bold.svg?raw';
import monitor from '../assets/iconsax/monitor-bold.svg?raw';
import grid from '../assets/iconsax/element-4-bold.svg?raw';
import pen from '../assets/iconsax/pen-tool-bold.svg?raw';
import mobile from '../assets/iconsax/mobile-bold.svg?raw';
import arrow from '../assets/iconsax/arrow-up-linear.svg?raw';
import tick from '../assets/iconsax/tick-square-linear.svg?raw';
const icons = { tick, layer, monitor, grid, pen, mobile, arrow };
interface Props { name: keyof typeof icons; size?: number; rotate?: number }
const { name, size = 16, rotate = 0 } = Astro.props;
---
<span class="iconsax" aria-hidden="true" style={`--icon-size:${size}px;transform:rotate(${rotate}deg)`} set:html={icons[name]} />
<style>
  .iconsax { display: inline-flex; align-items: center; justify-content: center; width: var(--icon-size); height: var(--icon-size); flex: 0 0 var(--icon-size); line-height: 0; }
  .iconsax :global(svg) { display: block; width: var(--icon-size); height: var(--icon-size); flex: none; }
</style>
