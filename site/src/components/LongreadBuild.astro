---
// Анатомия урока, вариант 2: слева заголовок и названия блоков, справа страница урока собирается из блоков друг под другом.
import Iconsax from './Iconsax.astro';

interface Props { base: string }
const { base } = Astro.props;
const blocks = ['Шапка', 'Содержание', 'Текст с картинкой', 'Видео', 'Слайдер', 'Схема', 'Аккордеон', 'Конспект', 'Самопроверка'];
---
<div class="lb" data-build>
  <div class="lb-side">
    <slot />
    <ol class="lb-legend" aria-hidden="true">{blocks.map((b, i) => <li data-bl={i}>{b}</li>)}</ol>
  </div>
  <div class="lb-page" aria-hidden="true">
    <div class="lb-slot lb-head" data-b="0">
      <div class="lb-card lb-head__in">
        <div class="lb-head__text">
          <i class="lb-bar lb-bar--s"></i>
          <p class="lb-h1">С чего начать работу<br/>в Цифровой платформе</p>
          <div class="lb-tags"><span><Iconsax name="document-text-bold" size={14}/>Лонгрид</span><span><Iconsax name="clock-bold" size={14}/>10 минут</span></div>
        </div>
        <img class="lb-head__img" src={`${base}lesson-hero.png`} alt="" width="1466" height="1308" loading="lazy" decoding="async"/>
      </div>
    </div>
    <div class="lb-slot lb-toc" data-b="1">
      <div class="lb-card lb-toc__in">
        <b>Содержание</b>
        <ol>{[1, 0, 0, 0, 0, 0].map((on, i) => <li class={on ? 'is-now' : undefined}><i></i><span class="lb-bar" style={`width:${[70, 55, 80, 60, 75, 50][i]}%`}></span></li>)}</ol>
      </div>
    </div>
    <div class="lb-grid">
      <div class="lb-slot" data-b="2">
        <div class="lb-card lb-about">
          <img src={`${base}about-system.svg`} alt="" width="165" height="173" loading="lazy"/>
          <div class="lb-lines"><b>О системе</b><i class="lb-bar"></i><i class="lb-bar"></i><i class="lb-bar lb-bar--m"></i></div>
        </div>
      </div>
      <div class="lb-slot" data-b="3">
        <div class="lb-card lb-video">
          <span class="lb-video__play"><Iconsax name="play-circle-bold" size={40}/></span>
          <span class="lb-video__bar"><span></span></span>
        </div>
      </div>
      <div class="lb-slot" data-b="4">
        <div class="lb-card lb-slider">
          <div class="lb-slider__view"><div class="lb-slider__track">{[1, 2, 3].map((n) => <img src={`${base}task-${n}.svg`} alt="" width="1100" height="620" loading="lazy"/>)}</div></div>
          <div class="lb-slider__side"><div class="lb-lines"><b>Выбрать ответ</b><i class="lb-bar"></i><i class="lb-bar lb-bar--m"></i></div><div class="lb-slider__bar"><span class="lb-count">1 / 3</span><span class="lb-arrows"><i><Iconsax name="arrow-left2-linear" size={14}/></i><i><Iconsax name="arrow-right2-linear" size={14}/></i></span></div></div>
        </div>
      </div>
      <div class="lb-slot" data-b="5">
        <div class="lb-card lb-flow">
          <span class="lb-flow__line"><span></span></span>
          <span class="lb-flow__doc"><Iconsax name="document-text-bold" size={16}/></span>
          {[['edit2-bold', 'Черновик'], ['tick-circle-bold', 'Готовое задание'], ['archive-box-bold', 'Архив']].map(([ic, t], i) => <span class="lb-flow__node" style={`--i:${i}`}><i><Iconsax name={ic} size={20}/></i>{t}</span>)}
        </div>
      </div>
      <div class="lb-slot" data-b="6">
        <div class="lb-acc">{[65, 80, 50].map((v) => <div class="lb-card lb-acc__item"><i class="lb-bar" style={`width:${v}%`}></i><span><Iconsax name="add-linear" size={14}/></span></div>)}</div>
      </div>
      <div class="lb-slot" data-b="7">
        <div class="lb-card lb-doc"><span class="lb-doc__ic"><Iconsax name="document-download-bold" size={22}/></span><span><b>Конспект урока</b><small>PDF · 2 страницы</small></span></div>
      </div>
      <div class="lb-slot" data-b="8">
        <div class="lb-card lb-quiz">
          <i class="lb-bar lb-bar--m"></i>
          <div class="lb-quiz__opts"><span><i></i><i class="lb-bar"></i></span><span class="is-ok"><i><Iconsax name="tick-circle-bold" size={18}/></i><i class="lb-bar"></i></span><span><i></i><i class="lb-bar"></i></span></div>
        </div>
      </div>
    </div>
  </div>
</div>
