---
import Iconsax from './Iconsax.astro';
interface Props { category: string }
const { category } = Astro.props;
const icons = { 'UX/UI': 'layer', 'Веб-дизайн': 'monitor-bold', 'Дизайн-система': 'grid', 'Брендинг': 'pen', 'Мобильный дизайн': 'mobile', Edtech: 'teacher-bold', Medtech: 'health-bold', 'Редизайн': 'magicpen-bold', 'Музыка': 'music-bold', 'Наука': 'microscope-bold' } as const;
const name = icons[category as keyof typeof icons] ?? 'layer';
---
<Iconsax name={name} />
