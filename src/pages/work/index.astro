---
import BackLink from '../../components/BackLink.astro';
import Page from '../../layouts/Page.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ActionButton from '../../components/ActionButton.astro';
import { allProjects } from '../../data/projects';
---
<Page title="Мои работы">
  <header class="page-heading"><BackLink/><h1>Мои работы</h1><p>Сайты, интерфейсы и визуальные истории.</p></header>
  <section class="work" id="work" aria-label="Мои работы">{allProjects.slice(0,6).map(project => <ProjectCard project={project}/>)}</section>
  <div class="action-row"><ActionButton id="load-more" label="Показать ещё" showIcon={false}/></div>
  <p class="work-status" role="status" aria-live="polite"></p>
  <noscript><p class="work-status"><a href="/work/2/">Следующие проекты →</a></p></noscript>
  <script>
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    const button = document.querySelector<HTMLButtonElement>('#load-more')!;
    const status = document.querySelector<HTMLElement>('.work-status')!;
    button.addEventListener('click', async () => {
      button.disabled = true;
      status.textContent = 'Загружаем работы…';
      try {
        const response = await fetch('/work/2/');
        if (!response.ok) throw new Error('Load failed');
        const doc = new DOMParser().parseFromString(await response.text(), 'text/html');
        const cards = doc.querySelectorAll('#work > .project');
        if (!cards.length) throw new Error('Empty page');
        document.querySelector('#work')!.append(...cards);
        button.hidden = true;
        status.textContent = 'Все работы загружены';
        ScrollTrigger.refresh();
      } catch { status.textContent = 'Не удалось загрузить работы. Попробуйте ещё раз.'; }
      finally { button.disabled = false; }
    });
  </script>
</Page>
